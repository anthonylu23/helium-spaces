+base::DictValue BuildState(Profile* profile) {
+  base::DictValue state;
+
+  base::ListValue spaces;
+  if (SpaceRegistry* registry = SpaceRegistryFactory::GetForProfile(profile)) {
+    for (const Space& space : registry->spaces()) {
+      spaces.Append(space.ToValue());
+    }
+  }
+  state.Set("spaces", std::move(spaces));
+
+  base::ListValue windows;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&windows](BrowserWindowInterface* browser) {
+        TabStripModel* tab_strip = browser->GetTabStripModel();
+        base::ListValue tabs;
+        for (int i = 0; i < tab_strip->count(); ++i) {
+          content::WebContents* contents = tab_strip->GetWebContentsAt(i);
+          const base::Uuid space_id = SpaceTabHelper::GetSpaceId(contents);
+          tabs.Append(
+              base::DictValue()
+                  .Set("index", i)
+                  .Set("url", contents->GetVisibleURL().spec())
+                  .Set("title", base::UTF16ToUTF8(contents->GetTitle()))
+                  .Set("active", i == tab_strip->active_index())
+                  .Set("last_active", contents->GetLastActiveTime()
+                                          .InMillisecondsFSinceUnixEpoch())
+                  .Set("pinned", tab_strip->IsTabPinned(i))
+                  .Set("grouped", tab_strip->GetTabGroupForTab(i).has_value())
+                  .Set("space_id", space_id.is_valid()
+                                       ? space_id.AsLowercaseString()
+                                       : std::string())
+                  .Set("in_active_space", tab_strip->IsTabInActiveSpace(i)));
+        }
+        SpaceController* controller = SpaceController::From(browser);
+        windows.Append(
+            base::DictValue()
+                .Set("session_id", browser->GetSessionID().id())
+                .Set("active_space_id",
+                     controller
+                         ? controller->active_space_id().AsLowercaseString()
+                         : std::string())
+                .Set("tabs", std::move(tabs)));
+        return true;
+      });
+  state.Set("windows", std::move(windows));
+  return state;
+}
+
+BrowserWindowInterface* FindBrowser(Profile* profile, int session_id) {
+  BrowserWindowInterface* found = nullptr;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetSessionID().id() == session_id) {
+          found = browser;
+        }
+        return !found;
+      });
+  return found;
+}
+
+void ServePage(Profile* profile,
+               const std::string& path,
+               content::WebUIDataSource::GotDataCallback callback) {
+  std::string json =
+      base::WriteJsonWithOptions(BuildState(profile),
+                                 base::JsonOptions::OPTIONS_PRETTY_PRINT)
+          .value_or("{}");
+  std::string html =
+      "<!doctype html><meta charset=\"utf-8\">"
+      "<title>Spaces internals</title><pre id=\"state\">" +
+      base::EscapeForHTML(json) + "</pre>";
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::move(html)));
+}
+
+class SpacesInternalsHandler : public content::WebUIMessageHandler {
+ public:
+  explicit SpacesInternalsHandler(Profile* profile) : profile_(profile) {}
+  SpacesInternalsHandler(const SpacesInternalsHandler&) = delete;
+  SpacesInternalsHandler& operator=(const SpacesInternalsHandler&) = delete;
+  ~SpacesInternalsHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "addSpace", base::BindRepeating(&SpacesInternalsHandler::AddSpace,
+                                        base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "assignTab", base::BindRepeating(&SpacesInternalsHandler::AssignTab,
+                                         base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "closeTab", base::BindRepeating(&SpacesInternalsHandler::CloseTab,
+                                        base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "reopenClosedTab",
+        base::BindRepeating(&SpacesInternalsHandler::ReopenClosedTab,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "rewriteSession",
+        base::BindRepeating(&SpacesInternalsHandler::RewriteSession,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "removeSpace", base::BindRepeating(&SpacesInternalsHandler::RemoveSpace,
+                                           base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "switchSpace", base::BindRepeating(&SpacesInternalsHandler::SwitchSpace,
+                                           base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "activateTab", base::BindRepeating(&SpacesInternalsHandler::ActivateTab,
+                                           base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "pinTab", base::BindRepeating(&SpacesInternalsHandler::PinTab,
+                                      base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "closeOtherTabs",
+        base::BindRepeating(&SpacesInternalsHandler::CloseOtherTabs,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "runCommand", base::BindRepeating(&SpacesInternalsHandler::RunCommand,
+                                          base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "groupTabs", base::BindRepeating(&SpacesInternalsHandler::GroupTabs,
+                                         base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "setLayout", base::BindRepeating(&SpacesInternalsHandler::SetLayout,
+                                         base::Unretained(this)));
+  }
+
+ private:
+  void AddSpace(const base::ListValue& args) {
+    SpaceRegistry* registry = SpaceRegistryFactory::GetForProfile(profile_);
+    const std::string* name =
+        args.size() == 1 ? args[0].GetIfString() : nullptr;
+    if (registry && name) {
+      registry->AddSpace(*name, tab_groups::TabGroupColorId::kBlue, "");
+    }
+  }
+
+  void AssignTab(const base::ListValue& args) {
+    if (args.size() != 3) {
+      return;
+    }
+    std::optional<int> window_id = args[0].GetIfInt();
+    std::optional<int> index = args[1].GetIfInt();
+    const std::string* space = args[2].GetIfString();
+    SpaceRegistry* registry = SpaceRegistryFactory::GetForProfile(profile_);
+    if (!window_id || !index || !space || !registry) {
+      return;
+    }
+    base::Uuid space_id = base::Uuid::ParseLowercase(*space);
+    if (!space->empty() && !registry->GetSpace(space_id)) {
+      return;
+    }
+    TabStripModel* tab_strip = FindTabStrip(*window_id, *index);
+    if (!tab_strip) {
+      return;
+    }
+    if (SpaceController* controller =
+            SpaceController::From(FindBrowser(profile_, *window_id))) {
+      controller->MoveTabToSpace(tab_strip->GetTabAtIndex(*index), space_id);
+    } else {
+      SpaceTabHelper::SetSpaceId(tab_strip->GetWebContentsAt(*index), space_id);
+    }
+  }
+
+  void RemoveSpace(const base::ListValue& args) {
+    SpaceRegistry* registry = SpaceRegistryFactory::GetForProfile(profile_);
+    const std::string* space =
+        args.size() == 1 ? args[0].GetIfString() : nullptr;
+    if (registry && space) {
+      registry->RemoveSpace(base::Uuid::ParseLowercase(*space));
+    }
+  }
+
+  // switchSpace(window_session_id, space_id or "" for default)
+  void SwitchSpace(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    const std::string* space =
+        args.size() == 2 ? args[1].GetIfString() : nullptr;
+    if (!window_id || !space) {
+      return;
+    }
+    BrowserWindowInterface* browser = FindBrowser(profile_, *window_id);
+    if (SpaceController* controller =
+            browser ? SpaceController::From(browser) : nullptr) {
+      controller->SwitchToSpace(base::Uuid::ParseLowercase(*space));
+    }
+  }
+
+  // activateTab(window_session_id, tab_index)
+  void ActivateTab(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    if (!window_id || !index) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      tab_strip->ActivateTabAt(*index);
+    }
+  }
+
+  // pinTab(window_session_id, tab_index, pinned)
+  void PinTab(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 3 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 3 ? args[1].GetIfInt() : std::nullopt;
+    std::optional<bool> pinned =
+        args.size() == 3 ? args[2].GetIfBool() : std::nullopt;
+    if (!window_id || !index || !pinned) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      tab_strip->SetTabPinned(*index, *pinned);
+    }
+  }
+
+  // closeOtherTabs(window_session_id, tab_index), from the tab context menu.
+  void CloseOtherTabs(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    if (!window_id || !index) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      tab_strip->ExecuteContextMenuCommand(
+          *index, TabStripModel::CommandCloseOtherTabs);
+    }
+  }
+
+  // runCommand(window_session_id, name), as if from a keyboard shortcut.
+  void RunCommand(const base::ListValue& args) {
+    static const std::map<std::string, int> kCommands = {
+        {"newTab", IDC_NEW_TAB},
+        {"closeTab", IDC_CLOSE_TAB},
+        {"selectNextTab", IDC_SELECT_NEXT_TAB},
+        {"selectPreviousTab", IDC_SELECT_PREVIOUS_TAB},
+        {"selectFirstTab", IDC_SELECT_TAB_0},
+        {"selectLastTab", IDC_SELECT_LAST_TAB},
+    };
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    const std::string* name =
+        args.size() == 2 ? args[1].GetIfString() : nullptr;
+    if (!window_id || !name || !kCommands.contains(*name)) {
+      return;
+    }
+    if (BrowserWindowInterface* browser = FindBrowser(profile_, *window_id)) {
+      chrome::ExecuteCommand(browser, kCommands.at(*name));
+    }
+  }
+
+  // groupTabs(window_session_id, [tab_index, ...]): a new tab group.
+  void GroupTabs(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    const base::ListValue* list =
+        args.size() == 2 ? args[1].GetIfList() : nullptr;
+    BrowserWindowInterface* browser =
+        window_id ? FindBrowser(profile_, *window_id) : nullptr;
+    if (!browser || !list || list->empty() ||
+        !browser->GetTabStripModel()->SupportsTabGroups()) {
+      return;
+    }
+    std::vector<int> indices;
+    for (const base::Value& value : *list) {
+      std::optional<int> index = value.GetIfInt();
+      if (!index || !browser->GetTabStripModel()->ContainsIndex(*index)) {
+        return;
+      }
+      indices.push_back(*index);
+    }
+    browser->GetTabStripModel()->AddToNewGroup(indices);
+  }
+
+  // setLayout(window_session_id, layout): Helium's tab layout, 0 Classic,
+  // 1 Compact, 2 Vertical, 3 Dynamic.
+  void SetLayout(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> layout =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    if (!window_id || !layout || *layout < 0 ||
+        *layout > static_cast<int>(HeliumLayoutType::kMaxValue)) {
+      return;
+    }
+    BrowserWindowInterface* browser = FindBrowser(profile_, *window_id);
+    if (HeliumLayoutStateController* layout_controller =
+            browser ? HeliumLayoutStateController::From(browser) : nullptr) {
+      layout_controller->SetBrowserLayout(
+          static_cast<HeliumLayoutType>(*layout));
+    }
+  }
+
+  // Closes a tab the way the user would, so it can be reopened.
+  void CloseTab(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    if (!window_id || !index) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      tab_strip->CloseWebContentsAt(
+          *index, TabCloseTypes::CLOSE_USER_GESTURE |
+                      TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+
+  // Reopens the most recently closed tab, like Cmd+Shift+T.
+  void ReopenClosedTab(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 1 ? args[0].GetIfInt() : std::nullopt;
+    if (BrowserWindowInterface* browser =
+            window_id ? FindBrowser(profile_, *window_id) : nullptr) {
+      chrome::RestoreTab(browser);
+    }
+  }
+
+  void RewriteSession(const base::ListValue& args) {
+    if (SessionService* session_service =
+            SessionServiceFactory::GetForProfile(profile_)) {
+      session_service->ResetFromCurrentBrowsers();
+    }
+  }
+
+  // Returns the tab strip of window `window_id` if it has a tab at `index`.
+  TabStripModel* FindTabStrip(int window_id, int index) {
+    BrowserWindowInterface* browser = FindBrowser(profile_, window_id);
+    TabStripModel* tab_strip = browser ? browser->GetTabStripModel() : nullptr;
+    return tab_strip && tab_strip->ContainsIndex(index) ? tab_strip : nullptr;
+  }
+
+  raw_ptr<Profile> profile_;
+};
+
+}  // namespace
