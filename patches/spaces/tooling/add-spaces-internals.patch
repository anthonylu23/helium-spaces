+// chrome://spaces-internals, a debugging page for devutils/spaces_smoke.mjs.
+// It prints the profile's spaces and every tab's space as JSON inside
+// <pre id="state">, and takes these chrome.send() messages:
+//   addSpace(name)
+//   removeSpace(space_id)
+//   assignTab(window_session_id, tab_index, space_id or "" for default)
+//   switchSpace(window_session_id, space_id or "" for default)
+//   activateTab(window_session_id, tab_index)
+//   pinTab(window_session_id, tab_index, pinned)
+//   closeTab(window_session_id, tab_index)
+//   closeOtherTabs(window_session_id, tab_index)  From the tab context menu.
+//   runCommand(window_session_id, name)  newTab, closeTab, selectNextTab,
+//       selectPreviousTab, selectFirstTab or selectLastTab.
+//   groupTabs(window_session_id, [tab_index, ...])
+//   setLayout(window_session_id, layout)  0 Classic, 1 Compact, 2 Vertical,
+//       3 Dynamic.
+//   reopenClosedTab(window_session_id)  Like Cmd+Shift+T.
+//   rewriteSession()  Rewrites the session file from the open windows.
+// Reload the page to see the new state.
+class SpacesInternalsUI : public content::WebUIController {
+ public:
+  explicit SpacesInternalsUI(content::WebUI* web_ui);
+  SpacesInternalsUI(const SpacesInternalsUI&) = delete;
+  SpacesInternalsUI& operator=(const SpacesInternalsUI&) = delete;
+  ~SpacesInternalsUI() override;
+
+ private:
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+}  // namespace spaces
