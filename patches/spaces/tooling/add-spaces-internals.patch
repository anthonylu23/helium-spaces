+// The tab context menu built by tabMenu(), and whether tabMenuItem() last
+// found its item, kept per profile and shown in its state until the next
+// call, since each state load is a new page.
+struct TabMenuResults : public base::SupportsUserData::Data {
+  base::ListValue menu;
+  bool item_activated = false;
+};
+
+TabMenuResults& GetTabMenuResults(Profile* profile) {
+  static constexpr char kKey[] = "helium_spaces.internals_tab_menu";
+  auto* results = static_cast<TabMenuResults*>(profile->GetUserData(kKey));
+  if (!results) {
+    auto owned = std::make_unique<TabMenuResults>();
+    results = owned.get();
+    profile->SetUserData(kKey, std::move(owned));
+  }
+  return *results;
+}
+
+// Builds the tab context menu as the tab strip does, and runs its commands
+// the same way.
+class TabMenu : public ui::SimpleMenuModel::Delegate {
+ public:
+  TabMenu(TabStripModel* tab_strip, int index)
+      : tab_strip_(tab_strip),
+        index_(index),
+        model_(this,
+               TabMenuModelDelegate::From(
+                   tab_strip->delegate()->GetBrowserWindowInterface()),
+               tab_strip,
+               index) {}
+
+  // Each item's label, and a submenu's items.
+  base::ListValue Dump() { return Dump(&model_); }
+
+  // Activates the item at the end of `labels`, a path of labels through
+  // submenus. Returns false if there is none, or it or a parent is disabled
+  // or hidden, as the user couldn't choose it.
+  bool Activate(const std::vector<std::string>& labels) {
+    ui::MenuModel* menu = &model_;
+    for (size_t i = 0; i < labels.size(); ++i) {
+      std::optional<size_t> found;
+      for (size_t item = 0; item < menu->GetItemCount(); ++item) {
+        if (base::UTF16ToUTF8(menu->GetLabelAt(item)) == labels[i]) {
+          found = item;
+          break;
+        }
+      }
+      if (!found || !menu->IsEnabledAt(*found) || !menu->IsVisibleAt(*found)) {
+        return false;
+      }
+      if (i + 1 < labels.size()) {
+        menu = menu->GetSubmenuModelAt(*found);
+        if (!menu) {
+          return false;
+        }
+      } else {
+        menu->ActivatedAt(*found);
+      }
+    }
+    return true;
+  }
+
+  // ui::SimpleMenuModel::Delegate, as TabContextMenuController. Extension
+  // items, past the tab menu's own commands, count as disabled.
+  bool IsCommandIdEnabled(int command_id) const override {
+    return command_id >= 0 &&
+           command_id <= TabStripModel::CommandAddToFavorites &&
+           tab_strip_->IsContextMenuCommandEnabled(
+               index_,
+               static_cast<TabStripModel::ContextMenuCommand>(command_id));
+  }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    tab_strip_->ExecuteContextMenuCommand(
+        index_, static_cast<TabStripModel::ContextMenuCommand>(command_id));
+  }
+
+ private:
+  static base::ListValue Dump(ui::MenuModel* menu) {
+    base::ListValue items;
+    for (size_t i = 0; i < menu->GetItemCount(); ++i) {
+      if (menu->GetTypeAt(i) == ui::MenuModel::TYPE_SEPARATOR ||
+          !menu->IsVisibleAt(i)) {
+        continue;
+      }
+      base::DictValue item;
+      item.Set("label", base::UTF16ToUTF8(menu->GetLabelAt(i)));
+      item.Set("enabled", menu->IsEnabledAt(i));
+      if (ui::MenuModel* submenu = menu->GetSubmenuModelAt(i)) {
+        item.Set("items", Dump(submenu));
+      }
+      items.Append(std::move(item));
+    }
+    return items;
+  }
+
+  const raw_ptr<TabStripModel> tab_strip_;
+  const int index_;
+  TabMenuModel model_;
+};
