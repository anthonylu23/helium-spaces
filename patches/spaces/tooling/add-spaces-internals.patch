+bool SpacesInternalsUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  return features::IsSpacesEnabled();
+}
+
+SpacesInternalsUI::SpacesInternalsUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, kChromeUISpacesInternalsHost);
+  source->SetRequestFilter(
+      base::BindRepeating([](const std::string& path) { return true; }),
+      base::BindRepeating(&ServePage, base::Unretained(profile)));
+  web_ui->AddMessageHandler(std::make_unique<SpacesInternalsHandler>(profile));
+}
+
+SpacesInternalsUI::~SpacesInternalsUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(SpacesInternalsUI)
+
+}  // namespace spaces
