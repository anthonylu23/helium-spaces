+  // runCommand(window_session_id, name), as if from a keyboard shortcut.
+  void RunCommand(const base::ListValue& args) {
+    static const std::map<std::string, int> kCommands = {
+        {"newTab", IDC_NEW_TAB},
+        {"closeTab", IDC_CLOSE_TAB},
+        {"selectNextTab", IDC_SELECT_NEXT_TAB},
+        {"selectPreviousTab", IDC_SELECT_PREVIOUS_TAB},
+        {"selectFirstTab", IDC_SELECT_TAB_0},
+        {"selectLastTab", IDC_SELECT_LAST_TAB},
+        {"moveTabNext", IDC_MOVE_TAB_NEXT},
+        {"moveTabPrevious", IDC_MOVE_TAB_PREVIOUS},
+        {"newWindow", IDC_NEW_WINDOW},
+        {"selectNextSpace", IDC_SELECT_NEXT_SPACE},
+        {"selectPreviousSpace", IDC_SELECT_PREVIOUS_SPACE},
+        {"selectSpace1", IDC_SELECT_SPACE_0},
+        {"selectSpace2", IDC_SELECT_SPACE_1},
+        {"selectSpace3", IDC_SELECT_SPACE_2},
+        {"selectSpace9", IDC_SELECT_SPACE_8},
+    };
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    const std::string* name =
+        args.size() == 2 ? args[1].GetIfString() : nullptr;
+    if (!window_id || !name || !kCommands.contains(*name)) {
+      return;
+    }
+    if (BrowserWindowInterface* browser = FindBrowser(profile_, *window_id)) {
+      chrome::ExecuteCommand(browser, kCommands.at(*name));
+    }
+  }
+
+  // groupTabs(window_session_id, [tab_index, ...]): a new tab group.
+  void GroupTabs(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    const base::ListValue* list =
+        args.size() == 2 ? args[1].GetIfList() : nullptr;
+    BrowserWindowInterface* browser =
+        window_id ? FindBrowser(profile_, *window_id) : nullptr;
+    if (!browser || !list || list->empty() ||
+        !browser->GetTabStripModel()->SupportsTabGroups()) {
+      return;
+    }
+    std::vector<int> indices;
+    for (const base::Value& value : *list) {
+      std::optional<int> index = value.GetIfInt();
+      if (!index || !browser->GetTabStripModel()->ContainsIndex(*index)) {
+        return;
+      }
+      indices.push_back(*index);
+    }
+    browser->GetTabStripModel()->AddToNewGroup(indices);
+  }
+
+  // dropOnSpace(window_session_id, [tab_index, ...], space_id, as_group):
+  // what dropping dragged tabs on a space's icon does. With `as_group`, the
+  // group of the first tab was dragged by its header.
+  void DropOnSpace(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 4 ? args[0].GetIfInt() : std::nullopt;
+    const base::ListValue* list =
+        args.size() == 4 ? args[1].GetIfList() : nullptr;
+    const std::string* space_id =
+        args.size() == 4 ? args[2].GetIfString() : nullptr;
+    std::optional<bool> as_group =
+        args.size() == 4 ? args[3].GetIfBool() : std::nullopt;
+    BrowserWindowInterface* browser =
+        window_id ? FindBrowser(profile_, *window_id) : nullptr;
+    SpaceController* controller =
+        browser ? SpaceController::From(browser) : nullptr;
+    if (!controller || !list || list->empty() || !space_id || !as_group) {
+      return;
+    }
+    TabStripModel* tab_strip = browser->GetTabStripModel();
+    std::vector<tabs::TabHandle> tabs;
+    for (const base::Value& value : *list) {
+      std::optional<int> index = value.GetIfInt();
+      if (!index || !tab_strip->ContainsIndex(*index)) {
+        return;
+      }
+      tabs.push_back(tab_strip->GetTabAtIndex(*index)->GetHandle());
+    }
+    std::optional<tab_groups::TabGroupId> group =
+        *as_group ? tabs.front().Get()->GetGroup() : std::nullopt;
+    controller->MoveDroppedTabsToSpace(std::move(tabs), group,
+                                       base::Uuid::ParseLowercase(*space_id));
+  }
+
+  // collapseGroup(window_session_id, tab_index): collapses the group of the
+  // tab at `tab_index` with the model calls BrowserTabStripController makes,
+  // which first activate another tab if the active one is in the group.
+  void CollapseGroup(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    TabStripModel* tab_strip =
+        window_id && index ? FindTabStrip(*window_id, *index) : nullptr;
+    std::optional<tab_groups::TabGroupId> group =
+        tab_strip ? tab_strip->GetTabGroupForTab(*index) : std::nullopt;
+    if (!group) {
+      return;
+    }
+    if (tab_strip->GetTabGroupForTab(tab_strip->active_index()) == group) {
+      if (std::optional<int> next =
+              tab_strip->GetNextExpandedActiveTab(*group)) {
+        tab_strip->ActivateTabAt(*next);
+      } else {
+        tab_strip->delegate()->AddTabAt(GURL(), -1, /*foreground=*/true);
+        return;
+      }
+    }
+    const tab_groups::TabGroupVisualData* visuals =
+        tab_strip->group_model()->GetTabGroup(*group)->visual_data();
+    tab_strip->ChangeTabGroupVisuals(
+        *group,
+        tab_groups::TabGroupVisualData(visuals->title(), visuals->color(),
+                                       /*is_collapsed=*/true));
+  }
+
+  // setLayout(window_session_id, layout): Helium's tab layout, 0 Classic,
+  // 1 Compact, 2 Vertical, 3 Dynamic.
+  void SetLayout(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> layout =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    if (!window_id || !layout || *layout < 0 ||
+        *layout > static_cast<int>(HeliumLayoutType::kMaxValue)) {
+      return;
+    }
+    BrowserWindowInterface* browser = FindBrowser(profile_, *window_id);
+    if (HeliumLayoutStateController* layout_controller =
+            browser ? HeliumLayoutStateController::From(browser) : nullptr) {
+      layout_controller->SetBrowserLayout(
+          static_cast<HeliumLayoutType>(*layout));
+    }
+  }
+
+  // moveTab(window_session_id, tab_index, to_index), as an extension's
+  // chrome.tabs.move() does.
+  void MoveTab(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 3 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 3 ? args[1].GetIfInt() : std::nullopt;
+    std::optional<int> to =
+        args.size() == 3 ? args[2].GetIfInt() : std::nullopt;
+    if (!window_id || !index || !to) {
+      return;
+    }
+    TabStripModel* tab_strip = FindTabStrip(*window_id, *index);
+    if (tab_strip && tab_strip->ContainsIndex(*to)) {
+      tab_strip->MoveWebContentsAt(*index, *to, /*select_after_move=*/false);
+    }
+  }
+
+  // moveTabToWindow(window_session_id, tab_index, target_window_session_id,
+  // target_index): what dropping a dragged tab, or "Move tab to another
+  // window", does. The tab becomes active there.
+  void MoveTabToWindow(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 4 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 4 ? args[1].GetIfInt() : std::nullopt;
+    std::optional<int> target_id =
+        args.size() == 4 ? args[2].GetIfInt() : std::nullopt;
+    std::optional<int> target_index =
+        args.size() == 4 ? args[3].GetIfInt() : std::nullopt;
+    if (!window_id || !index || !target_id || !target_index) {
+      return;
+    }
+    TabStripModel* tab_strip = FindTabStrip(*window_id, *index);
+    BrowserWindowInterface* target = FindBrowser(profile_, *target_id);
+    if (!tab_strip || !target || *target_id == *window_id) {
+      return;
+    }
+    const bool pinned = tab_strip->IsTabPinned(*index);
+    std::unique_ptr<tabs::TabModel> tab =
+        tab_strip->DetachTabAtForInsertion(*index);
+    target->GetTabStripModel()->InsertDetachedTabAt(
+        *target_index, std::move(tab),
+        AddTabTypes::ADD_ACTIVE | (pinned ? AddTabTypes::ADD_PINNED : 0));
+  }
+
+  // openLink(window_session_id, url, foreground): the active tab opens `url`
+  // in a new tab, as a link click with Cmd held does.
+  void OpenLink(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 3 ? args[0].GetIfInt() : std::nullopt;
+    const std::string* url = args.size() == 3 ? args[1].GetIfString() : nullptr;
+    std::optional<bool> foreground =
+        args.size() == 3 ? args[2].GetIfBool() : std::nullopt;
+    BrowserWindowInterface* browser =
+        window_id ? FindBrowser(profile_, *window_id) : nullptr;
+    content::WebContents* opener =
+        browser ? browser->GetTabStripModel()->GetActiveWebContents() : nullptr;
+    if (!opener || !url || !foreground) {
+      return;
+    }
+    opener->OpenURL(content::OpenURLParams(
+                        GURL(*url), content::Referrer(),
+                        *foreground ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                                    : WindowOpenDisposition::NEW_BACKGROUND_TAB,
+                        ui::PAGE_TRANSITION_LINK,
+                        /*is_renderer_initiated=*/false),
+                    {});
+  }
+
+  // openLinkInNewWindow(window_session_id, url): the active tab opens `url`
+  // in a new window, as "Open Link in New Window" or a Shift-click does.
+  void OpenLinkInNewWindow(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    const std::string* url = args.size() == 2 ? args[1].GetIfString() : nullptr;
+    BrowserWindowInterface* browser =
+        window_id ? FindBrowser(profile_, *window_id) : nullptr;
+    content::WebContents* opener =
+        browser ? browser->GetTabStripModel()->GetActiveWebContents() : nullptr;
+    if (!opener || !url) {
+      return;
+    }
+    opener->OpenURL(content::OpenURLParams(GURL(*url), content::Referrer(),
+                                           WindowOpenDisposition::NEW_WINDOW,
+                                           ui::PAGE_TRANSITION_LINK,
+                                           /*is_renderer_initiated=*/false),
+                    {});
+  }
+
+  // addToGroup(window_session_id, tab_index, index_of_a_tab_in_the_group),
+  // as "Add tab to group" or an extension's chrome.tabs.group() does.
+  void AddToGroup(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 3 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 3 ? args[1].GetIfInt() : std::nullopt;
+    std::optional<int> group_index =
+        args.size() == 3 ? args[2].GetIfInt() : std::nullopt;
+    if (!window_id || !index || !group_index) {
+      return;
+    }
+    TabStripModel* tab_strip = FindTabStrip(*window_id, *index);
+    const std::optional<tab_groups::TabGroupId> group =
+        tab_strip && tab_strip->ContainsIndex(*group_index)
+            ? tab_strip->GetTabGroupForTab(*group_index)
+            : std::nullopt;
+    if (group) {
+      tab_strip->AddToExistingGroup({*index}, *group);
+    }
+  }
+
+  // selectRange(window_session_id, tab_index, add): Shift-click from the
+  // active tab, or Cmd+Shift-click when `add` is true.
+  void SelectRange(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 3 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 3 ? args[1].GetIfInt() : std::nullopt;
+    std::optional<bool> add =
+        args.size() == 3 ? args[2].GetIfBool() : std::nullopt;
+    if (!window_id || !index || !add) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      if (*add) {
+        tab_strip->AddSelectionFromAnchorTo(*index);
+      } else {
+        tab_strip->ExtendSelectionTo(*index);
+      }
+    }
+  }
+
+  // moveSelectedTabs(window_session_id, to_index): what a tab drag does with
+  // the selected tabs, outside any group.
+  void MoveSelectedTabs(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> to =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    if (!window_id || !to) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *to)) {
+      tab_strip->MoveSelectedTabsTo(*to, std::nullopt);
+    }
+  }
+
+  // moveGroup(window_session_id, index_of_a_tab_in_the_group, to_index): what
+  // dragging a group header does.
+  void MoveGroup(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 3 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 3 ? args[1].GetIfInt() : std::nullopt;
+    std::optional<int> to =
+        args.size() == 3 ? args[2].GetIfInt() : std::nullopt;
+    if (!window_id || !index || !to) {
+      return;
+    }
+    TabStripModel* tab_strip = FindTabStrip(*window_id, *index);
+    const std::optional<tab_groups::TabGroupId> group =
+        tab_strip ? tab_strip->GetTabGroupForTab(*index) : std::nullopt;
+    if (group && tab_strip->ContainsIndex(*to)) {
+      tab_strip->MoveGroupTo(*group, *to);
+    }
+  }
+
+  // moveGroupToWindow(window_session_id, index_of_a_tab_in_the_group,
+  // target_window_session_id, target_index): dropping a dragged group header
+  // in another window.
+  void MoveGroupToWindow(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 4 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 4 ? args[1].GetIfInt() : std::nullopt;
+    std::optional<int> target_id =
+        args.size() == 4 ? args[2].GetIfInt() : std::nullopt;
+    std::optional<int> target_index =
+        args.size() == 4 ? args[3].GetIfInt() : std::nullopt;
+    if (!window_id || !index || !target_id || !target_index) {
+      return;
+    }
+    TabStripModel* tab_strip = FindTabStrip(*window_id, *index);
+    BrowserWindowInterface* target = FindBrowser(profile_, *target_id);
+    const std::optional<tab_groups::TabGroupId> group =
+        tab_strip ? tab_strip->GetTabGroupForTab(*index) : std::nullopt;
+    if (!group || !target || *target_id == *window_id ||
+        !target->GetTabStripModel()->SupportsTabGroups()) {
+      return;
+    }
+    target->GetTabStripModel()->InsertDetachedTabGroupAt(
+        tab_strip->DetachTabGroupForInsertion(*group), *target_index);
+  }
+
+  // moveTabsToNewWindow(window_session_id, [tab_index, ...]), as the tab
+  // menu's "Move tabs to new window" does.
+  void MoveTabsToNewWindow(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    const base::ListValue* list =
+        args.size() == 2 ? args[1].GetIfList() : nullptr;
+    BrowserWindowInterface* browser =
+        window_id ? FindBrowser(profile_, *window_id) : nullptr;
+    if (!browser || !list) {
+      return;
+    }
+    std::vector<int> indices;
+    for (const base::Value& value : *list) {
+      std::optional<int> index = value.GetIfInt();
+      if (!index || !browser->GetTabStripModel()->ContainsIndex(*index)) {
+        return;
+      }
+      indices.push_back(*index);
+    }
+    if (chrome::CanMoveTabsToNewWindow(browser, indices)) {
+      chrome::MoveTabsToNewWindow(browser, indices);
+    }
+  }
+
+  // moveSplitToWindow(window_session_id, index_of_a_tab_in_the_split,
+  // target_window_session_id, target_index): dropping a dragged split view in
+  // another window.
+  void MoveSplitToWindow(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 4 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 4 ? args[1].GetIfInt() : std::nullopt;
+    std::optional<int> target_id =
+        args.size() == 4 ? args[2].GetIfInt() : std::nullopt;
+    std::optional<int> target_index =
+        args.size() == 4 ? args[3].GetIfInt() : std::nullopt;
+    if (!window_id || !index || !target_id || !target_index) {
+      return;
+    }
+    TabStripModel* tab_strip = FindTabStrip(*window_id, *index);
+    BrowserWindowInterface* target = FindBrowser(profile_, *target_id);
+    const std::optional<split_tabs::SplitTabId> split =
+        tab_strip ? tab_strip->GetTabAtIndex(*index)->GetSplit() : std::nullopt;
+    if (!split || !target || *target_id == *window_id) {
+      return;
+    }
+    const bool pinned = tab_strip->IsTabPinned(*index);
+    target->GetTabStripModel()->InsertDetachedSplitTabAt(
+        tab_strip->DetachSplitTabForInsertion(*split), *target_index, pinned);
+  }
+
+  // splitTabs(window_session_id, [tab_index, tab_index]): a split view.
+  void SplitTabs(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    const base::ListValue* list =
+        args.size() == 2 ? args[1].GetIfList() : nullptr;
+    BrowserWindowInterface* browser =
+        window_id ? FindBrowser(profile_, *window_id) : nullptr;
+    if (!browser || !list || list->size() != 2) {
+      return;
+    }
+    std::vector<int> indices;
+    for (const base::Value& value : *list) {
+      std::optional<int> index = value.GetIfInt();
+      if (!index || !browser->GetTabStripModel()->ContainsIndex(*index)) {
+        return;
+      }
+      indices.push_back(*index);
+    }
+    browser->GetTabStripModel()->AddToNewSplit(
+        indices, split_tabs::SplitTabVisualData(),
+        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  }
+
+  // tabMenuCommand(window_session_id, tab_index, name): a tab context menu
+  // command on the tab at `tab_index`.
+  void TabMenuCommand(const base::ListValue& args) {
+    static const std::map<std::string, TabStripModel::ContextMenuCommand>
+        kCommands = {
+            {"closeTabsToLeft", TabStripModel::CommandCloseTabsToLeft},
+            {"togglePinned", TabStripModel::CommandTogglePinned},
+            {"addToFavorites", TabStripModel::CommandAddToFavorites},
+        };
+    std::optional<int> window_id =
+        args.size() == 3 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 3 ? args[1].GetIfInt() : std::nullopt;
+    const std::string* name =
+        args.size() == 3 ? args[2].GetIfString() : nullptr;
+    if (!window_id || !index || !name || !kCommands.contains(*name)) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      tab_strip->ExecuteContextMenuCommand(*index, kCommands.at(*name));
+    }
+  }
+
+  // tabMenu(window_session_id, tab_index): builds the tab context menu of the
+  // tab at `tab_index` and shows its items in the state as `tab_menu`.
+  void ShowTabMenu(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    base::ListValue& menu = GetTabMenuResults(profile_).menu;
+    menu.clear();
+    if (!window_id || !index) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      menu = TabMenu(tab_strip, *index).Dump();
+    }
+  }
+
+  // tabMenuItem(window_session_id, tab_index, [label, ...]): activates an
+  // item of the tab context menu, through submenus by their labels.
+  void ActivateTabMenuItem(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 3 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 3 ? args[1].GetIfInt() : std::nullopt;
+    const base::ListValue* path =
+        args.size() == 3 ? args[2].GetIfList() : nullptr;
+    bool& activated = GetTabMenuResults(profile_).item_activated;
+    activated = false;
+    if (!window_id || !index || !path) {
+      return;
+    }
+    std::vector<std::string> labels;
+    for (const base::Value& label : *path) {
+      if (!label.is_string()) {
+        return;
+      }
+      labels.push_back(label.GetString());
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      activated = TabMenu(tab_strip, *index).Activate(labels);
+    }
+  }
+
+  // Closes a tab the way the user would, so it can be reopened.
+  void CloseTab(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    if (!window_id || !index) {
+      return;
+    }
+    if (TabStripModel* tab_strip = FindTabStrip(*window_id, *index)) {
+      tab_strip->CloseWebContentsAt(
+          *index, TabCloseTypes::CLOSE_USER_GESTURE |
+                      TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+
+  // discardTab(window_session_id, tab_index): discards the tab, as Memory
+  // Saver does. Helium turns chrome://discards off.
+  void DiscardTab(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 2 ? args[0].GetIfInt() : std::nullopt;
+    std::optional<int> index =
+        args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+    TabStripModel* tab_strip =
+        window_id && index ? FindTabStrip(*window_id, *index) : nullptr;
+    if (!tab_strip) {
+      return;
+    }
+    if (resource_coordinator::TabLifecycleUnitExternal* lifecycle_unit =
+            resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+                tab_strip->GetWebContentsAt(*index))) {
+      lifecycle_unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::URGENT);
+    }
+  }
+
+  // Reopens the most recently closed tab, like Cmd+Shift+T.
+  void ReopenClosedTab(const base::ListValue& args) {
+    std::optional<int> window_id =
+        args.size() == 1 ? args[0].GetIfInt() : std::nullopt;
+    if (BrowserWindowInterface* browser =
+            window_id ? FindBrowser(profile_, *window_id) : nullptr) {
+      chrome::RestoreTab(browser);
+    }
+  }
+
+  void RewriteSession(const base::ListValue& args) {
+    if (SessionService* session_service =
+            SessionServiceFactory::GetForProfile(profile_)) {
+      session_service->ResetFromCurrentBrowsers();
+    }
+  }
+
+  // Returns the tab strip of window `window_id` if it has a tab at `index`.
+  TabStripModel* FindTabStrip(int window_id, int index) {
+    BrowserWindowInterface* browser = FindBrowser(profile_, window_id);
+    TabStripModel* tab_strip = browser ? browser->GetTabStripModel() : nullptr;
+    return tab_strip && tab_strip->ContainsIndex(index) ? tab_strip : nullptr;
+  }
+
+  raw_ptr<Profile> profile_;
+};
