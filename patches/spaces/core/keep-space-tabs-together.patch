+
+int SpaceController::WillInsertTabs(
+    const std::vector<tabs::TabInterface*>& tabs,
+    int index,
+    bool pinned,
+    std::optional<tab_groups::TabGroupId> group) {
+  if (tabs.empty()) {
+    return index;
+  }
+  const std::optional<base::Uuid> group_space =
+      group ? GetSpaceOfGroup(*group, {}) : std::nullopt;
+  // A window that only has favorites, such as one a selection was just moved
+  // to, takes the space of the first other tab moved in.
+  const bool window_shows_a_space = std::ranges::any_of(
+      *tab_strip_model_,
+      [this](const tabs::TabInterface* t) { return !IsFavorite(t); });
+  for (tabs::TabInterface* tab : tabs) {
+    content::WebContents* contents = tab->GetContents();
+    const SessionID last_window_id = SpaceTabHelper::GetLastWindowId(contents);
+    std::optional<base::Uuid> space_before_drag =
+        SpaceTabHelper::GetSpaceBeforeDrag(contents, window_id_);
+    if (group_space) {
+      SetTabSpace(contents, *group_space, /*before_insert=*/true);
+    } else if (!SpaceTabHelper::HasSpace(contents)) {
+      SetTabSpace(contents, active_space_id_, /*before_insert=*/true);
+    } else if (space_before_drag) {
+      // Dragged back to the window the drag started in, or put back there.
+      SetTabSpace(contents, ResolveSpace(*space_before_drag),
+                  /*before_insert=*/true);
+    } else if (last_window_id.is_valid() && last_window_id != window_id_ &&
+               window_shows_a_space &&
+               GetSpaceOfTab(tab, pinned) != GetFavoritesId()) {
+      // Moved from another window: it joins the space shown here, where it
+      // was dropped, as in Arc. Favorites stay favorites.
+      SetTabSpace(contents, active_space_id_, /*before_insert=*/true);
+    }
+    SpaceTabHelper::SetLastWindowId(contents, window_id_);
+  }
+  if (group_space || fixing_order_) {
+    return index;
+  }
+  return static_cast<int>(ConstrainTabIndex(
+      GetOrderKeys({}), {GetSpaceOfTab(tabs[0], pinned), pinned},
+      static_cast<size_t>(index), GetFavoritesId()));
+}
+
+int SpaceController::ConstrainMoveIndex(
+    const std::vector<tabs::TabInterface*>& tabs,
+    int index,
+    bool pinned,
+    std::optional<tab_groups::TabGroupId> group) const {
+  if (tabs.empty() || fixing_order_) {
+    return index;
+  }
+  // Chromium keeps tabs moved into a group with the group, which is in one
+  // space.
+  if (group && GetSpaceOfGroup(*group, tabs)) {
+    return index;
+  }
+  const base::Uuid space = GetSpaceOfTab(tabs[0], pinned);
+  if (!std::ranges::all_of(
+          tabs, [this, &space, pinned](const tabs::TabInterface* tab) {
+            return GetSpaceOfTab(tab, pinned) == space;
+          })) {
+    // Tabs of several spaces, which only an extension can select: let them
+    // go, and fix the order afterwards.
+    return index;
+  }
+  return static_cast<int>(ConstrainTabIndex(GetOrderKeys(tabs), {space, pinned},
+                                            static_cast<size_t>(index),
+                                            GetFavoritesId()));
+}
