+#include "chrome/browser/ui/spaces/space_order.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+
+namespace spaces {
+
+namespace {
+
+bool IsFavorite(const TabOrderKey& key, const base::Uuid& favorites) {
+  return key.pinned && key.space == favorites;
+}
+
+// The number of tabs at the start of `keys` that `predicate` accepts.
+template <typename Predicate>
+size_t CountLeading(base::span<const TabOrderKey> keys, Predicate predicate) {
+  size_t count = 0;
+  while (count < keys.size() && predicate(keys[count])) {
+    ++count;
+  }
+  return count;
+}
+
+}  // namespace
+
+bool IsTabOrderValid(base::span<const TabOrderKey> keys,
+                     const base::Uuid& favorites) {
+  const size_t pinned_count =
+      CountLeading(keys, [](const TabOrderKey& key) { return key.pinned; });
+  const size_t favorite_count =
+      CountLeading(keys, [&favorites](const TabOrderKey& key) {
+        return IsFavorite(key, favorites);
+      });
+  std::vector<TabOrderKey> finished_runs;
+  for (size_t i = 0; i < keys.size(); ++i) {
+    if (keys[i].pinned != (i < pinned_count) ||
+        IsFavorite(keys[i], favorites) != (i < favorite_count)) {
+      return false;
+    }
+    if (i > 0 && keys[i - 1] != keys[i]) {
+      if (std::ranges::contains(finished_runs, keys[i])) {
+        return false;
+      }
+      finished_runs.push_back(keys[i - 1]);
+    }
+  }
+  return true;
+}
+
+size_t ConstrainTabIndex(base::span<const TabOrderKey> keys,
+                         const TabOrderKey& key,
+                         size_t index,
+                         const base::Uuid& favorites) {
+  const size_t pinned_count =
+      CountLeading(keys, [](const TabOrderKey& key) { return key.pinned; });
+  const size_t favorite_count =
+      CountLeading(keys, [&favorites](const TabOrderKey& key) {
+        return IsFavorite(key, favorites);
+      });
+
+  size_t begin = key.pinned ? 0 : pinned_count;
+  size_t end = key.pinned ? pinned_count : keys.size();
+  if (IsFavorite(key, favorites)) {
+    end = favorite_count;
+  } else if (key.pinned) {
+    begin = std::min(favorite_count, end);
+  }
+  index = std::clamp(index, begin, end);
+
+  std::optional<size_t> run_begin;
+  size_t run_end = 0;
+  for (size_t i = begin; i < end; ++i) {
+    if (keys[i] == key) {
+      run_begin = run_begin.value_or(i);
+      run_end = i + 1;
+    }
+  }
+  if (run_begin) {
+    return std::clamp(index, *run_begin, run_end);
+  }
+
+  const auto distance = [index](size_t position) {
+    return position > index ? position - index : index - position;
+  };
+  size_t nearest = begin;
+  for (size_t edge = begin; edge <= end; ++edge) {
+    const bool is_edge =
+        edge == begin || edge == end || keys[edge - 1] != keys[edge];
+    if (is_edge && distance(edge) <= distance(nearest)) {
+      nearest = edge;
+    }
+  }
+  return nearest;
+}
+
+std::vector<size_t> GetValidTabOrder(base::span<const TabOrderKey> units,
+                                     const base::Uuid& favorites) {
+  // Each run sorts by region (favorites, other pinned, unpinned), then by its
+  // first unit.
+  std::vector<TabOrderKey> runs;
+  std::vector<std::pair<size_t, size_t>> rank;
+  for (const TabOrderKey& key : units) {
+    auto it = std::ranges::find(runs, key);
+    if (it == runs.end()) {
+      it = runs.insert(runs.end(), key);
+    }
+    const size_t region = IsFavorite(key, favorites) ? 0 : (key.pinned ? 1 : 2);
+    rank.emplace_back(region, static_cast<size_t>(it - runs.begin()));
+  }
+
+  std::vector<size_t> order(units.size());
+  for (size_t i = 0; i < order.size(); ++i) {
+    order[i] = i;
+  }
+  std::ranges::stable_sort(
+      order, [&rank](size_t a, size_t b) { return rank[a] < rank[b]; });
+  return order;
+}
+
+}  // namespace spaces
