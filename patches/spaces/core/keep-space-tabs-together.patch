+std::optional<base::Uuid> SpaceController::GetSpaceOfGroup(
+    const tab_groups::TabGroupId& group,
+    const std::vector<tabs::TabInterface*>& excluding) const {
+  for (const tabs::TabInterface* tab : *tab_strip_model_) {
+    if (tab->GetGroup() == group && !std::ranges::contains(excluding, tab)) {
+      return GetSpaceOfTab(tab);
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<TabOrderKey> SpaceController::GetOrderKeys(
+    const std::vector<tabs::TabInterface*>& excluding) const {
+  std::vector<TabOrderKey> keys;
+  for (const tabs::TabInterface* tab : *tab_strip_model_) {
+    if (!std::ranges::contains(excluding, tab)) {
+      keys.push_back({GetSpaceOfTab(tab), tab->IsPinned()});
+    }
+  }
+  return keys;
+}
+
+void SpaceController::MaybeFixOrderLater() {
+  if (fix_order_posted_ || fixing_order_ || IsOrderValid()) {
+    return;
+  }
+  // The tab strip can't be changed while it notifies observers, and the
+  // order may only be broken halfway through a change.
+  fix_order_posted_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SpaceController::FixOrderIfInvalid,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SpaceController::FixOrderIfInvalid() {
+  fix_order_posted_ = false;
+  if (tab_strip_model_->closing_all() || IsOrderValid()) {
+    return;
+  }
+  // A change the hooks in TabStripModel don't cover.
+  LOG(WARNING) << "helium-spaces: fixing the tab order";
+  ++order_fix_count_;
+  FixOrder();
+}
+
+void SpaceController::FixOrder() {
+  // Units are tabs that move together: a group, a split view, or a tab.
+  struct Unit {
+    tabs::TabHandle first_tab;
+    int length = 0;
+    std::optional<tab_groups::TabGroupId> group;
+    std::optional<split_tabs::SplitTabId> split;
+  };
+  std::vector<Unit> units;
+  std::vector<TabOrderKey> keys;
+  for (int index = 0; index < tab_strip_model_->count();) {
+    tabs::TabInterface* tab = tab_strip_model_->GetTabAtIndex(index);
+    Unit unit{tab->GetHandle(), 0, tab->GetGroup(),
+              tab->GetGroup() ? std::nullopt : tab->GetSplit()};
+    do {
+      ++unit.length;
+      ++index;
+    } while (
+        index < tab_strip_model_->count() &&
+        ((unit.group &&
+          tab_strip_model_->GetTabAtIndex(index)->GetGroup() == unit.group) ||
+         (unit.split &&
+          tab_strip_model_->GetTabAtIndex(index)->GetSplit() == unit.split)));
+    keys.push_back({GetSpaceOfTab(tab), tab->IsPinned()});
+    units.push_back(unit);
+  }
+
+  base::AutoReset<bool> fixing(&fixing_order_, true);
+  int target = 0;
+  for (size_t unit_index : GetValidTabOrder(keys, GetFavoritesId())) {
+    const Unit& unit = units[unit_index];
+    tabs::TabInterface* first_tab = unit.first_tab.Get();
+    const int index = tab_strip_model_->GetIndexOfTab(first_tab);
+    // Units before `target` are in place, so this one only moves left.
+    if (index != target) {
+      if (unit.group) {
+        tab_strip_model_->MoveGroupTo(*unit.group, target);
+      } else if (unit.split) {
+        tab_strip_model_->MoveSplitTo(*unit.split, target,
+                                      first_tab->IsPinned(), std::nullopt);
+      } else {
+        tab_strip_model_->MoveWebContentsAt(
+            index, target, /*select_after_move=*/false, std::nullopt);
+      }
+    }
+    target += unit.length;
+  }
 }
 
