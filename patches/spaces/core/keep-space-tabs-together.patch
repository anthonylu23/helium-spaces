+void SpaceController::WillSplitTabs(
+    const std::vector<tabs::TabInterface*>& tabs,
+    const tabs::TabInterface* pivot) {
+  // The pivot is the active tab, so its space is the active one, or it is a
+  // favorite and the split joins the favorites.
+  const base::Uuid space = GetSpaceOfTab(pivot);
+  for (tabs::TabInterface* tab : tabs) {
+    SetTabSpace(tab->GetContents(), space);
+  }
