+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_order.h"
+
+#include <cctype>
+#include <string>
+#include <vector>
+
+#include "base/uuid.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+
+namespace {
+
+// Tabs are written as one letter each: D, W and P for unpinned tabs of the
+// default, Work and Play spaces, lower case for pinned ones, and "f" for a
+// favorite.
+class SpaceOrderTest : public testing::Test {
+ protected:
+  TabOrderKey Key(char letter) const {
+    const char upper = static_cast<char>(std::toupper(letter));
+    const base::Uuid& space =
+        upper == 'F'
+            ? favorites_
+            : (upper == 'W' ? work_ : (upper == 'P' ? play_ : default_));
+    return {space, letter != upper};
+  }
+
+  std::vector<TabOrderKey> Keys(const std::string& tabs) const {
+    std::vector<TabOrderKey> keys;
+    for (char letter : tabs) {
+      keys.push_back(Key(letter));
+    }
+    return keys;
+  }
+
+  bool IsValid(const std::string& tabs) const {
+    return IsTabOrderValid(Keys(tabs), favorites_);
+  }
+
+  size_t Constrain(const std::string& tabs, char tab, size_t index) const {
+    return ConstrainTabIndex(Keys(tabs), Key(tab), index, favorites_);
+  }
+
+  // `tabs` reordered by GetValidTabOrder().
+  std::string Fix(const std::string& tabs) const {
+    std::string fixed;
+    for (size_t index : GetValidTabOrder(Keys(tabs), favorites_)) {
+      fixed += tabs[index];
+    }
+    return fixed;
+  }
+
+  const base::Uuid favorites_ = base::Uuid::GenerateRandomV4();
+  const base::Uuid default_ = base::Uuid::GenerateRandomV4();
+  const base::Uuid work_ = base::Uuid::GenerateRandomV4();
+  const base::Uuid play_ = base::Uuid::GenerateRandomV4();
+};
+
+TEST_F(SpaceOrderTest, ValidOrders) {
+  EXPECT_TRUE(IsValid(""));
+  EXPECT_TRUE(IsValid("D"));
+  EXPECT_TRUE(IsValid("DDWWPP"));
+  EXPECT_TRUE(IsValid("PPDDWW"));
+  EXPECT_TRUE(IsValid("ffwwppDWP"));
+  EXPECT_TRUE(IsValid("ffppwwWWDD"));
+  EXPECT_TRUE(IsValid("wwPP"));
+  // The default space's pinned tabs are a run like any space's.
+  EXPECT_TRUE(IsValid("ffddwwDW"));
+  EXPECT_TRUE(IsValid("wwddPP"));
+}
+
+TEST_F(SpaceOrderTest, InvalidOrders) {
+  EXPECT_FALSE(IsValid("WPW"));
+  EXPECT_FALSE(IsValid("DWWPD"));
+  EXPECT_FALSE(IsValid("wpwW"));
+  // Favorites come before other pinned tabs.
+  EXPECT_FALSE(IsValid("wfW"));
+  EXPECT_FALSE(IsValid("dfD"));
+  // Pinned tabs come first.
+  EXPECT_FALSE(IsValid("Ww"));
+}
+
+TEST_F(SpaceOrderTest, ConstrainKeepsIndexInsideTheRun) {
+  EXPECT_EQ(Constrain("DDWWWPP", 'W', 3), 3u);
+  EXPECT_EQ(Constrain("DDWWWPP", 'W', 2), 2u);
+  EXPECT_EQ(Constrain("DDWWWPP", 'W', 5), 5u);
+}
+
+TEST_F(SpaceOrderTest, ConstrainMovesIndexToTheRun) {
+  // Cmd+T in Work puts a tab at the end of the strip, after Play's tabs.
+  EXPECT_EQ(Constrain("DDWWWPP", 'W', 7), 5u);
+  EXPECT_EQ(Constrain("DDWWWPP", 'W', 0), 2u);
+  EXPECT_EQ(Constrain("DDWWWPP", 'D', 7), 2u);
+  EXPECT_EQ(Constrain("DDWWWPP", 'P', 0), 5u);
+}
+
+TEST_F(SpaceOrderTest, ConstrainWithNoRunPicksTheNearestEdge) {
+  EXPECT_EQ(Constrain("DDWW", 'P', 4), 4u);
+  EXPECT_EQ(Constrain("DDWW", 'P', 0), 0u);
+  EXPECT_EQ(Constrain("DDDWW", 'P', 2), 3u);
+  EXPECT_EQ(Constrain("", 'P', 0), 0u);
+  // A tie goes to the later edge.
+  EXPECT_EQ(Constrain("DDWW", 'P', 1), 2u);
+  EXPECT_EQ(Constrain("DDDDWW", 'P', 2), 4u);
+}
+
+TEST_F(SpaceOrderTest, ConstrainKeepsPinnedTabsApart) {
+  // Unpinned tabs go after every pinned tab.
+  EXPECT_EQ(Constrain("fwWW", 'W', 0), 2u);
+  // Pinned tabs go before every unpinned tab.
+  EXPECT_EQ(Constrain("fwWW", 'w', 4), 2u);
+}
+
+TEST_F(SpaceOrderTest, ConstrainKeepsFavoritesFirst) {
+  EXPECT_EQ(Constrain("ffwwpp", 'f', 6), 2u);
+  EXPECT_EQ(Constrain("ffwwpp", 'f', 4), 2u);
+  EXPECT_EQ(Constrain("wwpp", 'f', 3), 0u);
+  EXPECT_EQ(Constrain("ffwwpp", 'w', 0), 2u);
+  // A space's first pinned tab goes after the favorites, the default space's
+  // too.
+  EXPECT_EQ(Constrain("ffpp", 'w', 0), 2u);
+  EXPECT_EQ(Constrain("ffpp", 'w', 4), 4u);
+  EXPECT_EQ(Constrain("ffpp", 'w', 3), 4u);
+  EXPECT_EQ(Constrain("ffwwpp", 'd', 0), 2u);
+  EXPECT_EQ(Constrain("ddwwpp", 'f', 3), 0u);
+}
+
+TEST_F(SpaceOrderTest, ConstrainGivesAValidOrder) {
+  const std::string orders[] = {"",       "D",        "ffwwpp",
+                                "DDWWPP", "fpPPWWDD", "ffddwwDD"};
+  for (const std::string& order : orders) {
+    for (char tab : std::string("DWPdwpf")) {
+      for (size_t index = 0; index <= order.size(); ++index) {
+        std::string result = order;
+        result.insert(Constrain(order, tab, index), 1, tab);
+        EXPECT_TRUE(IsValid(result))
+            << order << " + " << tab << " at " << index << " = " << result;
+      }
+    }
+  }
+}
+
+TEST_F(SpaceOrderTest, FixLeavesValidOrdersAlone) {
+  EXPECT_EQ(Fix(""), "");
+  EXPECT_EQ(Fix("ffwwppDDWWPP"), "ffwwppDDWWPP");
+  EXPECT_EQ(Fix("PPWWDD"), "PPWWDD");
+}
+
+TEST_F(SpaceOrderTest, FixJoinsRunsInOrderOfTheirFirstTab) {
+  EXPECT_EQ(Fix("WPW"), "WWP");
+  EXPECT_EQ(Fix("DWPDPW"), "DDWWPP");
+  // A removed space's tabs become default tabs, and its pinned tabs the
+  // default space's pinned tabs.
+  EXPECT_EQ(Fix("DDPPDD"), "DDDDPP");
+  EXPECT_EQ(Fix("ffddwwdd"), "ffddddww");
+}
+
+TEST_F(SpaceOrderTest, FixPutsFavoritesFirst) {
+  EXPECT_EQ(Fix("wwfpf"), "ffwwp");
+  EXPECT_EQ(Fix("wfWDw"), "fwwWD");
+  EXPECT_EQ(Fix("dwf"), "fdw");
+}
+
