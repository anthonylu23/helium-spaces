+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_ORDER_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_ORDER_H_
+
+#include <cstddef>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/uuid.h"
+
+namespace spaces {
+
+// Which run of the tab strip a tab belongs to. The tab strip keeps pinned tabs
+// first, and within that each space's pinned tabs together, and the same for
+// unpinned tabs. Favorites, pinned tabs whose space is `favorites`, come
+// before every other pinned tab.
+struct TabOrderKey {
+  base::Uuid space;
+  bool pinned = false;
+
+  friend bool operator==(const TabOrderKey&, const TabOrderKey&) = default;
+};
+
+// Whether `keys`, one per tab in tab strip order, follow the rule above.
+bool IsTabOrderValid(base::span<const TabOrderKey> keys,
+                     const base::Uuid& favorites);
+
+// Where a tab with `key` may go if inserted at `index` among `keys`, which
+// are in order and don't include it: `index`, clamped to the pinned or
+// unpinned tabs, then to `key`'s run if it has one. Otherwise the run edge
+// nearest to `index` (the later one on a tie), so no other run is split.
+size_t ConstrainTabIndex(base::span<const TabOrderKey> keys,
+                         const TabOrderKey& key,
+                         size_t index,
+                         const base::Uuid& favorites);
+
+// The order, as indices into `units`, that follows the rule above. A unit is
+// a tab, or tabs that must stay together, such as a tab group. Changes as
+// little as it can: units keep their order within a run, and runs keep the
+// order of their first units, except that favorites come first.
+std::vector<size_t> GetValidTabOrder(base::span<const TabOrderKey> units,
+                                     const base::Uuid& favorites);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_ORDER_H_
