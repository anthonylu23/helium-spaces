+// Shows one space at a time in a normal browser window, and keeps the window's
+// tabs in their spaces:
+// - The active space follows the active tab, so activating a tab in another
+//   space, by any means, switches to that space.
+// - While a favorite is active, the active space is the space of the most
+//   recently active tab that isn't one. That is how it survives a restart.
+// - New tabs join the active space. Restored tabs keep the space they had.
+// - Closing the last tab of the active space opens a new tab there, as in Arc,
+//   instead of leaving the space.
+// Owned by EmbedderBrowserWindowFeatures.
+class SpaceController : public TabSpaceFilter,
+                        public TabStripModelObserver,
+                        public SpaceRegistry::Observer {
+ public:
+  DECLARE_USER_DATA(SpaceController);
+
+  // Returns a controller for `browser` if it is a normal window of a profile
+  // with Spaces and HeliumSpaces is enabled, or null otherwise.
+  static std::unique_ptr<SpaceController> MaybeCreate(
+      BrowserWindowInterface* browser);
+
+  // Returns the controller of `browser`, or null if it has none.
+  static SpaceController* From(BrowserWindowInterface* browser);
+
+  SpaceController(BrowserWindowInterface* browser, SpaceRegistry* registry);
+  SpaceController(const SpaceController&) = delete;
+  SpaceController& operator=(const SpaceController&) = delete;
+  ~SpaceController() override;
+
+  // The id of the space shown. Always a space in the registry.
+  const base::Uuid& active_space_id() const { return active_space_id_; }
+
+  // Shows `space_id` and activates its most recently active tab, or opens a
+  // new tab in it if it has none. An unknown id means the default space.
+  void SwitchToSpace(const base::Uuid& space_id);
+
+  // Moves `tab` to `space_id`; an unknown id means the default space. If `tab`
+  // was the active tab, the window stays in the active space and activates
+  // another tab there.
+  void MoveTabToSpace(tabs::TabInterface* tab, const base::Uuid& space_id);
+
+  // The space `tab` belongs to: the default space if it has none, or if its
+  // space no longer exists.
+  base::Uuid GetSpaceOfTab(const tabs::TabInterface* tab) const;
+
+  // Whether `tab` is a favorite: pinned, in the default space, and shown in
+  // every space.
+  bool IsFavorite(const tabs::TabInterface* tab) const;
+
+  // TabSpaceFilter:
+  bool IsTabInActiveSpace(const tabs::TabInterface* tab) const override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  // SpaceRegistry::Observer:
+  void OnSpacesChanged() override;
+
+ private:
+  // Returns `space_id` if it is in the registry, else the default space.
+  base::Uuid ResolveSpace(const base::Uuid& space_id) const;
+
+  // The space the active tab says should be shown. See the class comment.
+  base::Uuid GetSpaceForActiveTab() const;
+
+  // The most recently active tab, not a favorite, that `predicate` accepts.
+  tabs::TabInterface* FindMostRecentTab(
+      base::FunctionRef<bool(const tabs::TabInterface*)> predicate) const;
+
+  bool HasTabsInSpace(const base::Uuid& space_id) const;
+
+  // Activates the active space's most recently active tab, or opens a new tab
+  // there if it has none.
+  void ActivateTabInActiveSpace();
+
+  // Opens a new tab in the active space if the last one was just closed and
+  // nothing else has been shown there since.
+  void OpenTabInEmptiedSpace();
+
+  // Stores `space_id` on `contents`, where the default space is stored as no
+  // id, so it stays out of the session file.
+  void SetTabSpace(content::WebContents* contents, const base::Uuid& space_id);
+
+  const raw_ptr<TabStripModel> tab_strip_model_;
+  const raw_ptr<SpaceRegistry> registry_;
+  base::Uuid active_space_id_;
+
+  base::ScopedObservation<SpaceRegistry, SpaceRegistry::Observer>
+      registry_observation_{this};
+  ui::ScopedUnownedUserData<SpaceController> scoped_data_;
+  base::WeakPtrFactory<SpaceController> weak_factory_{this};
+};
+
