+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_TAB_SPACE_FILTER_H_
+#define CHROME_BROWSER_UI_SPACES_TAB_SPACE_FILTER_H_
+
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace spaces {
+
+// Lets TabStripModel and tab commands skip tabs outside the window's active
+// space, the way they skip tabs outside a focused tab group, and lets tab strip
+// views lay out again when that changes. SpaceController implements it and
+// sets itself on its window's TabStripModel. Header only, so the tab strip and
+// its views can depend on it without depending on Spaces.
+class TabSpaceFilter {
+ public:
+  // Whether `tab` is shown in the active space: it belongs to that space, or
+  // it is a favorite, which shows in every space.
+  virtual bool IsTabInActiveSpace(const tabs::TabInterface* tab) const = 0;
+
+  // Called before `tabs` are closed, outside the TabStripModel's re-entrancy
+  // guard, so the tab strip can still be changed: if they include the active
+  // tab and the active space's last other tabs, a new tab is opened there
+  // first, so the window stays in the space.
