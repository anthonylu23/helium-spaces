+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace spaces {
+
+DEFINE_USER_DATA(SpaceController);
+
+// static
+std::unique_ptr<SpaceController> SpaceController::MaybeCreate(
+    BrowserWindowInterface* browser) {
+  if (!features::IsSpacesEnabled() ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return nullptr;
+  }
+  // Null for incognito and guest profiles.
+  SpaceRegistry* registry =
+      SpaceRegistryFactory::GetForProfile(browser->GetProfile());
+  if (!registry) {
+    return nullptr;
+  }
+  return std::make_unique<SpaceController>(browser, registry);
+}
+
+// static
+SpaceController* SpaceController::From(BrowserWindowInterface* browser) {
+  return ui::ScopedUnownedUserData<SpaceController>::Get(
+      browser->GetUnownedUserDataHost());
+}
+
+SpaceController::SpaceController(BrowserWindowInterface* browser,
+                                 SpaceRegistry* registry)
+    : tab_strip_model_(browser->GetTabStripModel()),
+      registry_(registry),
+      active_space_id_(registry->GetDefaultSpace().id),
+      scoped_data_(browser->GetUnownedUserDataHost(), *this) {
+  tab_strip_model_->AddObserver(this);
+  tab_strip_model_->SetSpaceFilter(this);
+  registry_observation_.Observe(registry_);
+}
+
+SpaceController::~SpaceController() {
+  tab_strip_model_->SetSpaceFilter(nullptr);
+  tab_strip_model_->RemoveObserver(this);
+}
+
+void SpaceController::SwitchToSpace(const base::Uuid& space_id) {
+  const base::Uuid space = ResolveSpace(space_id);
+  if (space == active_space_id_) {
+    return;
+  }
+  SetActiveSpace(space);
+  ActivateTabInActiveSpace();
+}
+
+void SpaceController::MoveTabToSpace(tabs::TabInterface* tab,
+                                     const base::Uuid& space_id) {
+  const base::Uuid space = ResolveSpace(space_id);
+  if (space == GetSpaceOfTab(tab)) {
+    return;
+  }
+  if (tab->GetGroup()) {
+    tab_strip_model_->RemoveFromGroup({tab_strip_model_->GetIndexOfTab(tab)});
+  }
+  SetTabSpace(tab->GetContents(), space);
+  if (tab == tab_strip_model_->GetActiveTab() && !IsTabInActiveSpace(tab)) {
+    ActivateTabInActiveSpace();
+  }
+  tab_visibility_changed_callbacks_.Notify();
+}
+
+base::CallbackListSubscription SpaceController::RegisterTabVisibilityChanged(
+    base::RepeatingClosure callback) {
+  return tab_visibility_changed_callbacks_.Add(std::move(callback));
+}
+
+base::Uuid SpaceController::GetSpaceOfTab(const tabs::TabInterface* tab) const {
+  return ResolveSpace(SpaceTabHelper::GetSpaceId(tab->GetContents()));
+}
+
+bool SpaceController::IsFavorite(const tabs::TabInterface* tab) const {
+  return tab->IsPinned() &&
+         GetSpaceOfTab(tab) == registry_->GetDefaultSpace().id;
+}
+
+bool SpaceController::IsTabInActiveSpace(const tabs::TabInterface* tab) const {
+  return IsFavorite(tab) || GetSpaceOfTab(tab) == active_space_id_;
+}
+
+void SpaceController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  bool emptied_active_space = false;
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+      for (const auto& inserted : change.GetInsert()->contents) {
+        if (!SpaceTabHelper::HasSpace(inserted.contents)) {
+          SetTabSpace(inserted.contents, active_space_id_);
+        }
+      }
+      break;
+    case TabStripModelChange::kRemoved:
+      emptied_active_space =
+          std::ranges::any_of(change.GetRemove()->contents,
+                              [](const auto& removed) {
+                                return removed.remove_reason ==
+                                       TabRemovedReason::kDeleted;
+                              }) &&
+          !HasTabsInSpace(active_space_id_);
+      break;
+    case TabStripModelChange::kReplaced: {
+      // Discarding a tab replaces its WebContents.
+      const TabStripModelChange::Replace* replace = change.GetReplace();
+      SetTabSpace(
+          replace->new_contents,
+          ResolveSpace(SpaceTabHelper::GetSpaceId(replace->old_contents)));
+      break;
+    }
+    default:
+      break;
+  }
+
+  if (tab_strip_model_->closing_all()) {
+    return;
+  }
+  if (emptied_active_space) {
+    // WillCloseTabs() opens a tab first when tabs are closed through the tab
+    // strip; this covers tabs deleted any other way. The tab strip can't be
+    // changed while it notifies observers.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SpaceController::OpenTabInEmptiedSpace,
+                                  weak_factory_.GetWeakPtr()));
+    return;
+  }
+
+  tabs::TabInterface* active_tab = tab_strip_model_->GetActiveTab();
+  if (!active_tab) {
+    return;
+  }
+  if (selection.active_tab_changed() && !IsFavorite(active_tab)) {
+    SetActiveSpace(GetSpaceOfTab(active_tab));
+    last_active_tabs_[active_space_id_] = active_tab->GetHandle();
+  } else if (change.type() == TabStripModelChange::kInserted &&
+             IsFavorite(active_tab)) {
+    // While a favorite is active, inserted tabs can change which space was
+    // used last: session restore activates the first tab before inserting the
+    // rest.
+    SetActiveSpace(GetSpaceForActiveTab());
+  }
+}
+
+void SpaceController::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                              int index) {
+  // Unpinning the active favorite makes it an ordinary tab of the default
+  // space, which may not be the active one.
+  const tabs::TabInterface* active_tab = tab_strip_model_->GetActiveTab();
+  if (active_tab && !IsTabInActiveSpace(active_tab)) {
+    SetActiveSpace(GetSpaceOfTab(active_tab));
+  }
+}
+
+void SpaceController::WillCloseTabs(
+    const std::vector<tabs::TabInterface*>& tabs) {
+  const tabs::TabInterface* active_tab = tab_strip_model_->GetActiveTab();
+  if (!active_tab || !std::ranges::contains(tabs, active_tab) ||
+      static_cast<int>(tabs.size()) >= tab_strip_model_->count()) {
+    return;
+  }
+  const bool space_keeps_a_tab =
+      FindMostRecentTab([this, &tabs](const tabs::TabInterface* tab) {
+        return GetSpaceOfTab(tab) == active_space_id_ &&
+               !std::ranges::contains(tabs, tab);
+      }) != nullptr;
+  if (!space_keeps_a_tab) {
+    // Opened in the foreground, so closing `tabs` doesn't activate a tab of
+    // another space first. It joins the active space when inserted.
+    tab_strip_model_->delegate()->AddTabAt(GURL(), -1, /*foreground=*/true);
+  }
+}
+
+void SpaceController::OnSpacesChanged() {
+  // Tabs of a removed space now belong to the default space.
+  if (!registry_->GetSpace(active_space_id_)) {
+    SetActiveSpace(GetSpaceForActiveTab());
+  }
+}
+
+void SpaceController::SetActiveSpace(const base::Uuid& space_id) {
+  if (space_id == active_space_id_) {
+    return;
+  }
+  active_space_id_ = space_id;
+  tab_visibility_changed_callbacks_.Notify();
+}
+
+base::Uuid SpaceController::ResolveSpace(const base::Uuid& space_id) const {
+  return space_id.is_valid() && registry_->GetSpace(space_id)
+             ? space_id
+             : registry_->GetDefaultSpace().id;
+}
+
+base::Uuid SpaceController::GetSpaceForActiveTab() const {
+  const tabs::TabInterface* active_tab = tab_strip_model_->GetActiveTab();
+  if (active_tab && !IsFavorite(active_tab)) {
+    return GetSpaceOfTab(active_tab);
+  }
+  const tabs::TabInterface* recent_tab =
+      FindMostRecentTab([](const tabs::TabInterface*) { return true; });
+  return recent_tab ? GetSpaceOfTab(recent_tab)
+                    : ResolveSpace(active_space_id_);
+}
+
+tabs::TabInterface* SpaceController::FindMostRecentTab(
+    base::FunctionRef<bool(const tabs::TabInterface*)> predicate) const {
+  tabs::TabInterface* recent_tab = nullptr;
+  base::TimeTicks recent_time;
+  for (tabs::TabInterface* tab : *tab_strip_model_) {
+    if (IsFavorite(tab) || !predicate(tab)) {
+      continue;
+    }
+    const base::TimeTicks time = tab->GetContents()->GetLastActiveTimeTicks();
+    if (!recent_tab || time > recent_time) {
+      recent_tab = tab;
+      recent_time = time;
+    }
+  }
+  return recent_tab;
+}
+
+bool SpaceController::HasTabsInSpace(const base::Uuid& space_id) const {
+  return FindMostRecentTab([this, &space_id](const tabs::TabInterface* tab) {
+           return GetSpaceOfTab(tab) == space_id;
+         }) != nullptr;
+}
+
+void SpaceController::ActivateTabInActiveSpace() {
+  // Prefer the tab last active in the space. Last-active times alone would
+  // favor a tab opened in the background after it, which was never shown.
+  tabs::TabInterface* tab = nullptr;
+  if (auto it = last_active_tabs_.find(active_space_id_);
+      it != last_active_tabs_.end()) {
+    tabs::TabInterface* remembered = it->second.Get();
+    if (remembered &&
+        tab_strip_model_->GetIndexOfTab(remembered) != TabStripModel::kNoTab &&
+        !IsFavorite(remembered) &&
+        GetSpaceOfTab(remembered) == active_space_id_) {
+      tab = remembered;
+    }
+  }
+  if (!tab) {
+    tab = FindMostRecentTab([this](const tabs::TabInterface* tab) {
+      return GetSpaceOfTab(tab) == active_space_id_;
+    });
+  }
+  if (!tab) {
+    // An empty URL opens the New Tab page. The new tab joins the active space
+    // when it is inserted.
+    tab_strip_model_->delegate()->AddTabAt(GURL(), -1, /*foreground=*/true);
+    return;
+  }
+  if (tab != tab_strip_model_->GetActiveTab()) {
+    tab_strip_model_->ActivateTabAt(
+        tab_strip_model_->GetIndexOfTab(tab),
+        TabStripUserGestureDetails(
+            TabStripUserGestureDetails::GestureType::kOther));
+  }
+}
+
+void SpaceController::OpenTabInEmptiedSpace() {
+  if (tab_strip_model_->empty() || tab_strip_model_->closing_all()) {
+    return;
+  }
+  if (HasTabsInSpace(active_space_id_)) {
+    SetActiveSpace(GetSpaceForActiveTab());
+    return;
+  }
+  ActivateTabInActiveSpace();
+}
+
+void SpaceController::SetTabSpace(content::WebContents* contents,
+                                  const base::Uuid& space_id) {
+  SpaceTabHelper::SetSpaceId(
+      contents,
+      space_id == registry_->GetDefaultSpace().id ? base::Uuid() : space_id);
+}
+
+bool IsTabHiddenBySpace(const tabs::TabInterface* tab) {
+  const BrowserWindowInterface* browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  const SpaceController* controller =
+      browser ? ui::ScopedUnownedUserData<SpaceController>::Get(
+                    browser->GetUnownedUserDataHost())
+              : nullptr;
+  return controller && !controller->IsTabInActiveSpace(tab);
+}
+
+}  // namespace spaces
