+  SpaceController* controller =
+      browser ? SpaceController::From(browser) : nullptr;
+  tabs::TabInterface* source_tab =
+      source_contents
+          ? tabs::TabInterface::MaybeGetFromContents(source_contents)
+          : nullptr;
+  BrowserWindowInterface* source_browser =
+      source_tab ? source_tab->GetBrowserWindowInterface() : nullptr;
+  SpaceController* source_controller =
+      source_browser ? SpaceController::From(source_browser) : nullptr;
+  if (!controller || !source_controller || source_controller == controller ||
+      !browser->GetTabStripModel()->empty()) {
