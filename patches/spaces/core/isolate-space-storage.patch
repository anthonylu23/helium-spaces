+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_partition.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_controller.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+#include "chrome/browser/ui/spaces/space_tab_helper.h"
+#include "chrome/browser/ui/spaces/spaces_features.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace spaces {
+
+namespace {
+
+// Each space gets its own partition domain, so that one space's storage can
+// be deleted as a whole. A domain may only hold [a-z], so the id's hex digits
+// are spelled with the letters a to p.
+constexpr char kPartitionDomainPrefix[] = "heliumspace";
+
+std::string PartitionDomain(const base::Uuid& space_id) {
+  std::string domain = kPartitionDomainPrefix;
+  for (char c : space_id.AsLowercaseString()) {
+    if (c >= '0' && c <= '9') {
+      domain += static_cast<char>('a' + (c - '0'));
+    } else if (c >= 'a' && c <= 'f') {
+      domain += static_cast<char>('a' + 10 + (c - 'a'));
+    }
+  }
+  return domain;
+}
+
+scoped_refptr<content::SiteInstance> SiteInstanceForSpace(
+    Profile* profile,
+    const base::Uuid& space_id) {
+  std::optional<content::StoragePartitionConfig> config =
+      GetPartitionConfig(profile, space_id);
+  if (!config) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(profile, GURL(),
+                                                               *config);
+}
+
+}  // namespace
+
+std::optional<content::StoragePartitionConfig> GetPartitionConfig(
+    Profile* profile,
+    const base::Uuid& space_id) {
+  if (!features::IsSpacesEnabled()) {
+    return std::nullopt;
+  }
+  SpaceRegistry* registry = SpaceRegistryFactory::GetForProfile(profile);
+  if (!registry) {
+    return std::nullopt;
+  }
+  // An unknown id is the default space's, as everywhere else.
+  const Space* space =
+      space_id.is_valid() ? registry->GetSpace(space_id) : nullptr;
+  if (!space) {
+    space = &registry->GetDefaultSpace();
+  }
+  if (space->isolation != SpaceIsolation::kPartition) {
+    return std::nullopt;
+  }
+  return content::StoragePartitionConfig::Create(
+      profile, PartitionDomain(space->id), space->partition,
+      /*in_memory=*/profile->IsOffTheRecord());
+}
+
+scoped_refptr<content::SiteInstance> GetSiteInstanceForNewTab(
+    BrowserWindowInterface* browser) {
+  // New tabs always join the window's active space.
+  SpaceController* controller =
+      browser ? SpaceController::From(browser) : nullptr;
+  if (!controller) {
+    return nullptr;
+  }
+  return SiteInstanceForSpace(browser->GetProfile(),
+                              controller->active_space_id());
+}
+
+scoped_refptr<content::SiteInstance> GetSiteInstanceForRestoredTab(
+    Profile* profile,
+    const std::map<std::string, std::string>& extra_data) {
+  auto it = extra_data.find(kSpaceIdExtraDataKey);
+  return SiteInstanceForSpace(
+      profile, it != extra_data.end() ? base::Uuid::ParseLowercase(it->second)
+                                      : base::Uuid());
+}
+
+bool IsInSpacePartition(content::WebContents& contents) {
+  return contents.GetPrimaryMainFrame()
+      ->GetStoragePartition()
+      ->GetConfig()
+      .partition_domain()
+      .starts_with(kPartitionDomainPrefix);
+}
+
+}  // namespace spaces
