+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_storage_path.h"
+
+#include "base/files/file_path.h"
+#include "base/uuid.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+
+namespace {
+
+base::Uuid SpaceId() {
+  return base::Uuid::ParseLowercase("0123abcd-4567-89ef-0a1b-2c3d4e5f6789");
+}
+
+TEST(SpaceStoragePathTest, DomainSpellsTheIdInLetters) {
+  EXPECT_EQ(GetSpacePartitionDomain(SpaceId()),
+            "heliumspaceabcdklmnefghijopakblcmdneofpghij");
+  EXPECT_TRUE(IsSpacePartitionDomain(GetSpacePartitionDomain(SpaceId())));
+  for (char c : GetSpacePartitionDomain(base::Uuid::GenerateRandomV4())) {
+    EXPECT_TRUE(c >= 'a' && c <= 'z') << c;
+  }
+}
+
+TEST(SpaceStoragePathTest, OtherDomainsAreNoSpaces) {
+  EXPECT_FALSE(IsSpacePartitionDomain(""));
+  EXPECT_FALSE(IsSpacePartitionDomain("aapaabbbccddeeffgghh"));
+  EXPECT_FALSE(IsSpacePartitionDomain("helium"));
+}
+
+TEST(SpaceStoragePathTest, StoragePath) {
+  const base::FilePath path = GetSpaceStoragePath(SpaceId());
+  EXPECT_EQ(path, base::FilePath(FILE_PATH_LITERAL("Storage"))
+                      .Append(FILE_PATH_LITERAL("ext"))
+                      .AppendASCII(GetSpacePartitionDomain(SpaceId())));
+  // A partition's own folder is one level down, named `def` or by a hash.
+  EXPECT_TRUE(IsSpaceStoragePath(path.Append(FILE_PATH_LITERAL("def"))));
+  EXPECT_TRUE(IsSpaceStoragePath(path));
+}
+
+TEST(SpaceStoragePathTest, OtherPathsAreNoSpaces) {
+  EXPECT_FALSE(IsSpaceStoragePath(base::FilePath()));
+  EXPECT_FALSE(IsSpaceStoragePath(
+      base::FilePath(FILE_PATH_LITERAL("Storage/ext/aapaabbbcc/def"))));
+  EXPECT_FALSE(IsSpaceStoragePath(
+      base::FilePath(FILE_PATH_LITERAL("Other/ext/heliumspaceab/def"))));
+  EXPECT_FALSE(IsSpaceStoragePath(
+      base::FilePath(FILE_PATH_LITERAL("Storage/heliumspaceab/def"))));
+}
+
+}  // namespace
+
+}  // namespace spaces
