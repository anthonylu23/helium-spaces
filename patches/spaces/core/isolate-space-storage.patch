+void SpaceController::MoveTabToItsPartitionLater(tabs::TabInterface* tab,
+                                                 bool new_tab) {
+  partition_moves_.emplace_back(tab->GetHandle(), new_tab);
+  PostPartitionMoves();
+}
+
+void SpaceController::PostPartitionMoves() {
+  if (partition_moves_posted_ || partition_moves_.empty()) {
+    return;
+  }
+  // The tab strip can't be changed while it notifies observers.
+  partition_moves_posted_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SpaceController::MoveTabsToTheirPartitions,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SpaceController::MoveTabsToTheirPartitions() {
+  partition_moves_posted_ = false;
+  // A dragged tab joins the space of every window it passes over; it moves
+  // once it is dropped. RegisterTabDragEnded() posts this again then.
+  if (IsTabDragInProgress() || tab_strip_model_->closing_all()) {
+    return;
+  }
+  const std::vector<std::pair<tabs::TabHandle, bool>> moves =
+      std::exchange(partition_moves_, {});
+  for (const auto& [handle, new_tab] : moves) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab || tab_strip_model_->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+      // Gone, or moved to another window, whose controller moves it.
+      continue;
+    }
+    content::WebContents* contents = tab->GetContents();
+    const std::optional<content::StoragePartitionConfig> partition =
+        GetPartitionOfSpace(profile_, GetSpaceOfTab(tab));
+    if (IsInPartition(*contents, partition)) {
+      continue;
+    }
+    if (new_tab) {
+      // A way of opening tabs the hooks don't cover.
+      LOG(WARNING) << "helium-spaces: moving a new tab to its space's storage";
+      ++partition_fix_count_;
+    }
+    // Like a discard: the tab keeps its place, group and history, and reloads
+    // in the new partition.
+    std::unique_ptr<content::WebContents> old_contents =
+        tab_strip_model_->DiscardWebContents(
+            contents, CreateContentsInPartition(*contents, partition));
+    if (tab == tab_strip_model_->GetActiveTab()) {
+      tab->GetContents()->GetController().LoadIfNecessary();
+    }
+  }
+}
+
+std::set<base::Uuid> SpaceController::GetIsolatedSpaces() const {
+  std::set<base::Uuid> isolated;
+  for (const Space& space : registry_->spaces()) {
+    if (space.isolation == SpaceIsolation::kPartition) {
+      isolated.insert(space.id);
+    }
+  }
+  return isolated;
 }
 
