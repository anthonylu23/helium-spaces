+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_partition.h"
+
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+#include "chrome/browser/ui/spaces/space_storage_path.h"
+#include "chrome/browser/ui/spaces/space_tab_helper.h"
+#include "chrome/browser/ui/spaces/spaces_features.h"
+#include "components/sessions/content/content_serialized_navigation_builder.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/restore_type.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace spaces {
+
+namespace {
+
+const content::StoragePartitionConfig& GetPartitionOf(
+    content::WebContents& contents) {
+  return contents.GetPrimaryMainFrame()->GetStoragePartition()->GetConfig();
+}
+
+}  // namespace
+
+std::optional<content::StoragePartitionConfig> GetPartitionConfig(
+    Profile* profile,
+    const base::Uuid& space_id) {
+  if (!features::IsSpacesEnabled()) {
+    return std::nullopt;
+  }
+  SpaceRegistry* registry = SpaceRegistryFactory::GetForProfile(profile);
+  if (!registry) {
+    return std::nullopt;
+  }
+  const Space* space =
+      space_id.is_valid() ? registry->GetSpace(space_id) : nullptr;
+  if (!space) {
+    space = &registry->GetDefaultSpace();
+  }
+  if (space->isolation != SpaceIsolation::kPartition) {
+    return std::nullopt;
+  }
+  return content::StoragePartitionConfig::Create(
+      profile, GetSpacePartitionDomain(space->id), space->partition,
+      /*in_memory=*/profile->IsOffTheRecord());
+}
+
+scoped_refptr<content::SiteInstance> CreateSiteInstanceInPartition(
+    Profile* profile,
+    const std::optional<content::StoragePartitionConfig>& partition) {
+  if (!partition) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(profile, GURL(),
+                                                               *partition);
+}
+
+scoped_refptr<content::SiteInstance> GetSiteInstanceForRestoredTab(
+    Profile* profile,
+    const std::map<std::string, std::string>& extra_data) {
+  auto it = extra_data.find(kSpaceIdExtraDataKey);
+  return CreateSiteInstanceInPartition(
+      profile,
+      GetPartitionConfig(profile, it != extra_data.end()
+                                      ? base::Uuid::ParseLowercase(it->second)
+                                      : base::Uuid()));
+}
+
+scoped_refptr<content::SiteInstance> GetSiteInstanceForDiscardedTab(
+    content::WebContents& contents) {
+  if (!IsInSpacePartition(contents)) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(
+      contents.GetBrowserContext(), GURL(), GetPartitionOf(contents));
+}
+
+bool IsInSpacePartition(content::WebContents& contents) {
+  return IsSpacePartitionDomain(GetPartitionOf(contents).partition_domain());
+}
+
+bool IsInPartition(
+    content::WebContents& contents,
+    const std::optional<content::StoragePartitionConfig>& partition) {
+  const content::StoragePartitionConfig& current = GetPartitionOf(contents);
+  if (!partition) {
+    return current.is_default();
+  }
+  return current.partition_domain() == partition->partition_domain() &&
+         current.partition_name() == partition->partition_name() &&
+         current.in_memory() == partition->in_memory();
+}
+
+std::unique_ptr<content::WebContents> CreateContentsInPartition(
+    content::WebContents& contents,
+    const std::optional<content::StoragePartitionConfig>& partition) {
+  Profile* profile = Profile::FromBrowserContext(contents.GetBrowserContext());
+  content::WebContents::CreateParams create_params(
+      profile, CreateSiteInstanceInPartition(profile, partition));
+  create_params.initially_hidden =
+      contents.GetVisibility() == content::Visibility::HIDDEN;
+  create_params.desired_renderer_state =
+      content::WebContents::CreateParams::kNoRendererProcess;
+  create_params.last_active_time = contents.GetLastActiveTime();
+  create_params.last_active_time_ticks = contents.GetLastActiveTimeTicks();
+  std::unique_ptr<content::WebContents> new_contents =
+      content::WebContents::Create(create_params);
+  new_contents->SetUserAgentOverride(contents.GetUserAgentOverride(),
+                                     /*override_in_new_tabs=*/false);
+
+  // The history goes through the session format, as for a restored tab:
+  // NavigationController::CopyStateFrom() would keep the old partition's
+  // SiteInstances.
+  content::NavigationController& controller = contents.GetController();
+  std::vector<sessions::SerializedNavigationEntry> navigations;
+  int selected = -1;
+  for (int i = 0; i < controller.GetEntryCount(); ++i) {
+    content::NavigationEntry* entry = controller.GetEntryAtIndex(i);
+    if (entry->IsInitialEntry()) {
+      continue;
+    }
+    if (i == controller.GetLastCommittedEntryIndex()) {
+      selected = static_cast<int>(navigations.size());
+    }
+    navigations.push_back(
+        sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+            static_cast<int>(navigations.size()), entry));
+  }
+  if (navigations.empty()) {
+    // Nothing committed yet: load what the tab was loading.
+    const GURL url = contents.GetVisibleURL();
+    if (url.is_valid()) {
+      new_contents->GetController().LoadURL(url, content::Referrer(),
+                                            ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                            std::string());
+    }
+    return new_contents;
+  }
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries =
+      sessions::ContentSerializedNavigationBuilder::ToNavigationEntries(
+          navigations, profile);
+  new_contents->GetController().Restore(
+      selected >= 0 ? selected : static_cast<int>(entries.size()) - 1,
+      content::RestoreType::kRestored, &entries);
+  return new_contents;
+}
+
