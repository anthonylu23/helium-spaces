+// folders still in use are deleted by the garbage collection at the next
+// startup.
+void GarbageCollectAtNextStartup(base::WeakPtr<Profile> profile) {
+  if (profile) {
+    profile->GetPrefs()->SetBoolean(
+        ::prefs::kShouldGarbageCollectStoragePartitions, true);
+  }
+}
+
+}  // namespace
+
+void ClearSpaceStorage(Profile* profile, const base::Uuid& space_id) {
+  profile->AsyncObliterateStoragePartition(
+      GetSpacePartitionDomain(space_id),
+      base::BindOnce(&GarbageCollectAtNextStartup, profile->GetWeakPtr()),
+      base::DoNothing());
+}
+
+std::unordered_set<base::FilePath> GetSpaceStoragePaths(Profile* profile) {
+  std::unordered_set<base::FilePath> paths;
+  SpaceRegistry* registry = SpaceRegistryFactory::GetForProfile(profile);
+  if (!registry) {
+    return paths;
+  }
+  for (const Space& space : registry->spaces()) {
+    paths.insert(profile->GetPath().Append(GetSpaceStoragePath(space.id)));
+  }
+  return paths;
+}
+
+}  // namespace spaces
