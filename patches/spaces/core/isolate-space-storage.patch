+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_storage_path.h"
+
+#include <vector>
+
+namespace spaces {
+
+namespace {
+
+constexpr char kPartitionDomainPrefix[] = "heliumspace";
+
+// content/browser/storage_partition_impl_map.cc keeps a partition with a
+// domain in `Storage/ext/<domain>`.
+constexpr base::FilePath::CharType kStoragePartitionDirname[] =
+    FILE_PATH_LITERAL("Storage");
+constexpr base::FilePath::CharType kExtensionsDirname[] =
+    FILE_PATH_LITERAL("ext");
+
+}  // namespace
+
+std::string GetSpacePartitionDomain(const base::Uuid& space_id) {
+  // A domain may only hold [a-z], so the id's hex digits are spelled with the
+  // letters a to p.
+  std::string domain = kPartitionDomainPrefix;
+  for (char c : space_id.AsLowercaseString()) {
+    if (c >= '0' && c <= '9') {
+      domain += static_cast<char>('a' + (c - '0'));
+    } else if (c >= 'a' && c <= 'f') {
+      domain += static_cast<char>('a' + 10 + (c - 'a'));
+    }
+  }
+  return domain;
+}
+
+bool IsSpacePartitionDomain(std::string_view partition_domain) {
+  return partition_domain.starts_with(kPartitionDomainPrefix);
+}
+
+base::FilePath GetSpaceStoragePath(const base::Uuid& space_id) {
+  return base::FilePath(kStoragePartitionDirname)
+      .Append(kExtensionsDirname)
+      .AppendASCII(GetSpacePartitionDomain(space_id));
+}
+
+bool IsSpaceStoragePath(const base::FilePath& relative_path) {
+  const std::vector<base::FilePath::StringType> components =
+      relative_path.GetComponents();
+  return components.size() >= 3 && components[0] == kStoragePartitionDirname &&
+         components[1] == kExtensionsDirname &&
+         IsSpacePartitionDomain(base::FilePath(components[2]).AsUTF8Unsafe());
+}
+
+}  // namespace spaces
