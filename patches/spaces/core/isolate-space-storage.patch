+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/uuid.h"
+#include "content/public/browser/storage_partition_config.h"
+
+class Profile;
+
+namespace content {
+class SiteInstance;
+class WebContents;
+}  // namespace content
+
+namespace spaces {
+
+// Per-space isolation (`spikes/space-isolation.md`). A space with
+// SpaceIsolation::kPartition keeps its tabs in its own StoragePartition:
+// cookies, cache and site storage. A tab's partition is fixed when its
+// WebContents is created, so a tab that changes partition gets a new one;
+// SpaceController does that.
+
+// The partition `space_id`'s tabs use, or nullopt for the profile's default
+// one. An invalid or unknown id means the default space, as everywhere else.
+// Also nullopt while HeliumSpaces is disabled.
+std::optional<content::StoragePartitionConfig> GetPartitionConfig(
+    Profile* profile,
+    const base::Uuid& space_id);
+
+// A SiteInstance for a new WebContents in `partition`, or null for the
+// default partition.
+scoped_refptr<content::SiteInstance> CreateSiteInstanceInPartition(
+    Profile* profile,
+    const std::optional<content::StoragePartitionConfig>& partition);
+
+// The SiteInstance for a tab being restored with `extra_data`, in its space's
+// partition, or null if that space uses the default partition.
+scoped_refptr<content::SiteInstance> GetSiteInstanceForRestoredTab(
+    Profile* profile,
+    const std::map<std::string, std::string>& extra_data);
+
+// The SiteInstance for the WebContents replacing `contents` when it is
+// discarded, in the space partition `contents` is in, or null if it isn't in
+// one.
+scoped_refptr<content::SiteInstance> GetSiteInstanceForDiscardedTab(
+    content::WebContents& contents);
+
+// Whether `contents` is in a space's own partition.
+bool IsInSpacePartition(content::WebContents& contents);
+
+// Whether `contents` is in `partition`, where nullopt is the default one.
+bool IsInPartition(
+    content::WebContents& contents,
+    const std::optional<content::StoragePartitionConfig>& partition);
+
+// A new WebContents in `partition` with the history of `contents`, to
+// replace it. It isn't loaded yet; it loads when shown. Session storage and
+// the page's state aren't carried over.
+std::unique_ptr<content::WebContents> CreateContentsInPartition(
+    content::WebContents& contents,
+    const std::optional<content::StoragePartitionConfig>& partition);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_H_
