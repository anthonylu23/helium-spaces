+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/uuid.h"
+#include "content/public/browser/storage_partition_config.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace content {
+class SiteInstance;
+class WebContents;
+}  // namespace content
+
+namespace spaces {
+
+// Per-space isolation (Phase 5 spike, `spikes/space-isolation.md`). A space
+// with SpaceIsolation::kPartition keeps its tabs in its own StoragePartition:
+// cookies, cache and site storage. A tab's partition is fixed when it is
+// created, so it only follows the space a new or restored tab joins.
+
+// The partition `space_id`'s tabs use, or nullopt for the profile's default
+// one. Also nullopt while HeliumSpaces is disabled.
+std::optional<content::StoragePartitionConfig> GetPartitionConfig(
+    Profile* profile,
+    const base::Uuid& space_id);
+
+// The SiteInstance a new tab with no opener starts in when it opens in
+// `browser`: in the partition of the space it will join, the active one. Null
+// if that space uses the default partition.
+scoped_refptr<content::SiteInstance> GetSiteInstanceForNewTab(
+    BrowserWindowInterface* browser);
+
+// The SiteInstance for a tab being restored with `extra_data`, in its space's
+// partition, or null if that space uses the default partition.
+scoped_refptr<content::SiteInstance> GetSiteInstanceForRestoredTab(
+    Profile* profile,
+    const std::map<std::string, std::string>& extra_data);
+
+// Whether `contents` is in a space's own partition.
+bool IsInSpacePartition(content::WebContents& contents);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_H_
