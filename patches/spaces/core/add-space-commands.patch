@@ -135,4 +135,16 @@ std::vector<Space>::iterator SpaceList::
   return std::ranges::find(spaces_, id, &Space::id);
 }
 
+base::Uuid GetAdjacentSpaceId(const std::vector<Space>& spaces,
+                              const base::Uuid& id,
+                              bool forward) {
+  const auto it = std::ranges::find(spaces, id, &Space::id);
+  if (it == spaces.end()) {
+    return id;
+  }
+  const size_t index = std::distance(spaces.begin(), it);
+  const size_t size = spaces.size();
+  return spaces[(index + (forward ? 1 : size - 1)) % size].id;
+}
