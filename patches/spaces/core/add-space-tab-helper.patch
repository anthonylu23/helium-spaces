+
+#include "chrome/browser/ui/spaces/space_tab_helper.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/ui/spaces/spaces_features.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/session_command.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "content/public/browser/web_contents.h"
+
+namespace spaces {
+
+SpaceTabHelper::SpaceTabHelper(content::WebContents* contents)
+    : content::WebContentsUserData<SpaceTabHelper>(*contents) {}
+
+SpaceTabHelper::~SpaceTabHelper() = default;
+
+// static
+base::Uuid SpaceTabHelper::GetSpaceId(const content::WebContents* contents) {
+  const SpaceTabHelper* helper = FromWebContents(contents);
+  return helper ? helper->space_id_ : base::Uuid();
+}
+
+// static
+bool SpaceTabHelper::HasSpace(const content::WebContents* contents) {
+  return FromWebContents(contents);
+}
+
+// static
+void SpaceTabHelper::SetSpaceId(content::WebContents* contents,
+                                base::Uuid space_id) {
+  if (!features::IsSpacesEnabled()) {
+    return;
+  }
+  SpaceTabHelper* helper = GetOrCreateForWebContents(contents);
+  if (helper->space_id_ == space_id) {
+    return;
+  }
+  helper->space_id_ = space_id;
+
+  // A tab that isn't in a window yet is written at the next session rewrite.
+  SessionService* session_service = SessionServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!session_service || !window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+  // Written even when empty, to override an earlier id in the same file.
+  session_service->AddTabExtraData(
+      window_id, tab_id, kSpaceIdExtraDataKey,
+      space_id.is_valid() ? space_id.AsLowercaseString() : std::string());
+}
+
+std::unique_ptr<sessions::SessionCommand> CreateSpaceIdSessionCommand(
+    const content::WebContents* contents) {
+  if (!features::IsSpacesEnabled()) {
+    return nullptr;
+  }
+  const base::Uuid space_id = SpaceTabHelper::GetSpaceId(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!space_id.is_valid() || !tab_id.is_valid()) {
+    return nullptr;
+  }
+  return sessions::CreateAddTabExtraDataCommand(tab_id, kSpaceIdExtraDataKey,
+                                                space_id.AsLowercaseString());
+}
+
+void AddSpaceIdToExtraData(const content::WebContents* contents,
+                           std::map<std::string, std::string>* extra_data) {
+  if (!features::IsSpacesEnabled()) {
+    return;
+  }
+  const base::Uuid space_id = SpaceTabHelper::GetSpaceId(contents);
+  if (space_id.is_valid()) {
+    (*extra_data)[kSpaceIdExtraDataKey] = space_id.AsLowercaseString();
+  }
+}
+
+void RestoreSpaceIdFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  if (!features::IsSpacesEnabled()) {
+    return;
+  }
+  SpaceTabHelper* helper = SpaceTabHelper::GetOrCreateForWebContents(contents);
+  auto it = extra_data.find(kSpaceIdExtraDataKey);
+  if (it != extra_data.end()) {
+    helper->space_id_ = base::Uuid::ParseLowercase(it->second);
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SpaceTabHelper);
+
+}  // namespace spaces
