+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_TAB_HELPER_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_TAB_HELPER_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/uuid.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace sessions {
+class SessionCommand;
+}
+
+namespace spaces {
+
+// Tab extra data key holding a tab's space id, in session and tab restore
+// data. An empty value means the default space.
+inline constexpr char kSpaceIdExtraDataKey[] = "helium_spaces.space_id";
+
+// Which space a tab belongs to. An invalid id means the profile's default
+// space, and so does the id of a space that no longer exists.
+class SpaceTabHelper : public content::WebContentsUserData<SpaceTabHelper> {
+ public:
+  SpaceTabHelper(const SpaceTabHelper&) = delete;
+  SpaceTabHelper& operator=(const SpaceTabHelper&) = delete;
+  ~SpaceTabHelper() override;
+
+  // Returns the space id of `contents`, or an invalid id if it has none.
+  static base::Uuid GetSpaceId(const content::WebContents* contents);
+
+  // Whether `contents` has been given a space, even the default one. Restored
+  // tabs always have one; SpaceController gives one to every other new tab.
+  static bool HasSpace(const content::WebContents* contents);
+
+  // Moves `contents` to `space_id`, where an invalid id means the default
+  // space, and records it in the session so restore puts it back. Call it
+  // once the tab is in a window: before that the id is only kept in memory,
+  // and reaches the session file at its next rewrite. Does nothing while
+  // HeliumSpaces is disabled.
+  static void SetSpaceId(content::WebContents* contents, base::Uuid space_id);
+
+ private:
+  friend WebContentsUserData;
+  // Restoring sets the id without writing it back to the session.
+  friend void RestoreSpaceIdFromExtraData(
+      content::WebContents* contents,
+      const std::map<std::string, std::string>& extra_data);
+
+  explicit SpaceTabHelper(content::WebContents* contents);
+
+  base::Uuid space_id_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// Session glue, called from hooks in Chromium's session code. Each does
+// nothing while HeliumSpaces is disabled.
+
+// Returns a session command recording the space of `contents`, or null if it
+// has none. Called from SessionServiceBase::BuildCommandsForTab(), which
+// writes a tab from scratch when the session file is rewritten and when a tab
+// is restored, and otherwise drops tab extra data.
+std::unique_ptr<sessions::SessionCommand> CreateSpaceIdSessionCommand(
+    const content::WebContents* contents);
+
+// Adds the space of `contents` to the extra data of its tab restore entry.
+void AddSpaceIdToExtraData(const content::WebContents* contents,
+                           std::map<std::string, std::string>* extra_data);
+
+// Sets the space of a restored tab from its session or tab restore extra data,
+// the default space if it has none, so the tab keeps it when inserted. Doesn't
+// write to the session; restore then calls BuildCommandsForTab().
+void RestoreSpaceIdFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_TAB_HELPER_H_
