+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space.h"
+
+#include <utility>
+
+#include "base/json/values_util.h"
+
+namespace spaces {
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kColorKey[] = "color";
+constexpr char kIconKey[] = "icon";
+constexpr char kIsolationKey[] = "isolation";
+constexpr char kPartitionKey[] = "partition";
+constexpr char kLastActiveKey[] = "last_active";
+constexpr char kDefaultKey[] = "default";
+
+}  // namespace
+
+Space::Space() = default;
+Space::Space(const Space&) = default;
+Space& Space::operator=(const Space&) = default;
+Space::Space(Space&&) = default;
+Space& Space::operator=(Space&&) = default;
+Space::~Space() = default;
+
+// static
+std::optional<Space> Space::FromValue(const base::DictValue& value) {
+  const std::string* id = value.FindString(kIdKey);
+  if (!id) {
+    return std::nullopt;
+  }
+  Space space;
+  space.id = base::Uuid::ParseLowercase(*id);
+  if (!space.id.is_valid()) {
+    return std::nullopt;
+  }
+
+  if (const std::string* name = value.FindString(kNameKey)) {
+    space.name = *name;
+  }
+  if (std::optional<int> color = value.FindInt(kColorKey);
+      color && *color >= 0 &&
+      *color < std::to_underlying(tab_groups::TabGroupColorId::kNumEntries)) {
+    space.color = static_cast<tab_groups::TabGroupColorId>(*color);
+  }
+  if (const std::string* icon = value.FindString(kIconKey)) {
+    space.icon = *icon;
+  }
+  if (std::optional<int> isolation = value.FindInt(kIsolationKey);
+      isolation && *isolation >= 0 &&
+      *isolation <= std::to_underlying(SpaceIsolation::kMaxValue)) {
+    space.isolation = static_cast<SpaceIsolation>(*isolation);
+  }
+  if (const std::string* partition = value.FindString(kPartitionKey)) {
+    space.partition = *partition;
+  }
+  if (const base::Value* last_active = value.Find(kLastActiveKey)) {
+    space.last_active = base::ValueToTime(*last_active).value_or(base::Time());
+  }
+  space.is_default = value.FindBool(kDefaultKey).value_or(false);
+  return space;
+}
+
+base::DictValue Space::ToValue() const {
+  base::DictValue value;
+  value.Set(kIdKey, id.AsLowercaseString());
+  value.Set(kNameKey, name);
+  value.Set(kColorKey, std::to_underlying(color));
+  value.Set(kIconKey, icon);
+  value.Set(kIsolationKey, std::to_underlying(isolation));
+  value.Set(kPartitionKey, partition);
+  value.Set(kLastActiveKey, base::TimeToValue(last_active));
+  value.Set(kDefaultKey, is_default);
+  return value;
+}
+
+}  // namespace spaces
