+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace spaces {
+
+namespace prefs {
+// List pref holding the profile's spaces, in switcher order.
+inline constexpr char kSpaces[] = "helium_spaces.spaces";
+}  // namespace prefs
+
+// The spaces of one profile, persisted to prefs. Exists only for regular
+// profiles, and only while the HeliumSpaces feature is enabled.
+class SpaceRegistry : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // Called after a space is added, removed, changed or moved.
+    virtual void OnSpacesChanged() {}
+  };
+
+  explicit SpaceRegistry(PrefService* prefs);
+  SpaceRegistry(const SpaceRegistry&) = delete;
+  SpaceRegistry& operator=(const SpaceRegistry&) = delete;
+  ~SpaceRegistry() override;
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  const std::vector<Space>& spaces() const { return list_.spaces(); }
+  const Space* GetSpace(const base::Uuid& id) const;
+  const Space& GetDefaultSpace() const;
+
+  // Each mutator saves to prefs and notifies observers when it changes
+  // something. See SpaceList for the rules.
+  base::Uuid AddSpace(std::string name,
+                      tab_groups::TabGroupColorId color,
+                      std::string icon);
+  bool UpdateSpace(const Space& space);
+  bool RemoveSpace(const base::Uuid& id);
+  bool MoveSpace(const base::Uuid& id, size_t index);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  void SaveAndNotify();
+
+  raw_ptr<PrefService> prefs_;
+  SpaceList list_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace spaces
