+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+
+#include <memory>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_selections.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/spaces_features.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+
+namespace spaces {
+
+// static
+SpaceRegistry* SpaceRegistryFactory::GetForProfile(Profile* profile) {
+  return static_cast<SpaceRegistry*>(
+      GetInstance()->GetServiceForBrowserContext(profile, true));
+}
+
+// static
+SpaceRegistryFactory* SpaceRegistryFactory::GetInstance() {
+  static base::NoDestructor<SpaceRegistryFactory> instance;
+  return instance.get();
+}
+
+SpaceRegistryFactory::SpaceRegistryFactory()
+    : ProfileKeyedServiceFactory(
+          "SpaceRegistry",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kNone)
+              .WithSystem(ProfileSelection::kNone)
+              .WithAshInternals(ProfileSelection::kNone)
+              .Build()) {}
+
+SpaceRegistryFactory::~SpaceRegistryFactory() = default;
+
+std::unique_ptr<KeyedService>
+SpaceRegistryFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  if (!features::IsSpacesEnabled()) {
+    return nullptr;
+  }
+  Profile* profile = Profile::FromBrowserContext(context);
+  return std::make_unique<SpaceRegistry>(profile->GetPrefs());
+}
+
+// Created with the profile so the default space, and its id, exist before any
+// window asks for it.
+bool SpaceRegistryFactory::ServiceIsCreatedWithBrowserContext() const {
+  return features::IsSpacesEnabled();
+}
+
+// Registered even while the feature is disabled, so turning the flag off and
+// on again keeps the user's spaces.
+void SpaceRegistryFactory::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  SpaceRegistry::RegisterProfilePrefs(registry);
+}
+
+}  // namespace spaces
