+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_list.h"
+
+#include <algorithm>
+#include <iterator>
+#include <optional>
+#include <set>
+#include <utility>
+
+#include "base/check.h"
+
+namespace spaces {
+
+namespace {
+
+Space NewSpace(std::string name,
+               tab_groups::TabGroupColorId color,
+               std::string icon) {
+  Space space;
+  space.id = base::Uuid::GenerateRandomV4();
+  space.name = std::move(name);
+  space.color = color;
+  space.icon = std::move(icon);
+  return space;
+}
+
+Space NewDefaultSpace() {
+  Space space =
+      NewSpace(kDefaultSpaceName, tab_groups::TabGroupColorId::kGrey, "");
+  space.is_default = true;
+  return space;
+}
+
+}  // namespace
+
+SpaceList::SpaceList() : spaces_({NewDefaultSpace()}) {}
+SpaceList::SpaceList(std::vector<Space> spaces) : spaces_(std::move(spaces)) {}
+SpaceList::SpaceList(const SpaceList&) = default;
+SpaceList& SpaceList::operator=(const SpaceList&) = default;
+SpaceList::SpaceList(SpaceList&&) = default;
+SpaceList& SpaceList::operator=(SpaceList&&) = default;
+SpaceList::~SpaceList() = default;
+
+// static
+SpaceList SpaceList::FromValue(const base::ListValue& value) {
+  std::vector<Space> spaces;
+  std::set<std::string> seen_ids;
+  bool has_default = false;
+  for (const base::Value& entry : value) {
+    const base::DictValue* dict = entry.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    std::optional<Space> space = Space::FromValue(*dict);
+    if (!space || !seen_ids.insert(space->id.AsLowercaseString()).second) {
+      continue;
+    }
+    if (space->is_default) {
+      space->is_default = !has_default;
+      has_default = true;
+    }
+    spaces.push_back(std::move(*space));
+  }
+  if (!has_default) {
+    spaces.insert(spaces.begin(), NewDefaultSpace());
+  }
+  return SpaceList(std::move(spaces));
+}
+
+base::ListValue SpaceList::ToValue() const {
+  base::ListValue value;
+  for (const Space& space : spaces_) {
+    value.Append(space.ToValue());
+  }
+  return value;
+}
+
+const Space* SpaceList::Find(const base::Uuid& id) const {
+  auto it = std::ranges::find(spaces_, id, &Space::id);
+  return it == spaces_.end() ? nullptr : &*it;
+}
+
+const Space& SpaceList::default_space() const {
+  auto it = std::ranges::find_if(spaces_, &Space::is_default);
+  CHECK(it != spaces_.end());
+  return *it;
+}
+
+const Space& SpaceList::Add(std::string name,
+                            tab_groups::TabGroupColorId color,
+                            std::string icon) {
+  spaces_.push_back(NewSpace(std::move(name), color, std::move(icon)));
+  return spaces_.back();
+}
+
+bool SpaceList::Update(const Space& space) {
+  auto it = FindIterator(space.id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  const bool is_default = it->is_default;
+  *it = space;
+  it->is_default = is_default;
+  return true;
+}
+
+bool SpaceList::Remove(const base::Uuid& id) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end() || it->is_default) {
+    return false;
+  }
+  spaces_.erase(it);
+  return true;
+}
+
+bool SpaceList::Move(const base::Uuid& id, size_t index) {
+  auto it = FindIterator(id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  const size_t from = std::distance(spaces_.begin(), it);
+  const size_t to = std::min(index, spaces_.size() - 1);
+  if (from < to) {
+    std::rotate(it, it + 1, spaces_.begin() + to + 1);
+  } else if (from > to) {
+    std::rotate(spaces_.begin() + to, it, it + 1);
+  }
+  return true;
+}
+
+std::vector<Space>::iterator SpaceList::FindIterator(const base::Uuid& id) {
+  return std::ranges::find(spaces_, id, &Space::id);
+}
+
+}  // namespace spaces
