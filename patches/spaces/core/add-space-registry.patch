+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_list.h"
+
+#include <vector>
+
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+
+namespace {
+
+using tab_groups::TabGroupColorId;
+
+std::vector<std::string> Names(const SpaceList& list) {
+  std::vector<std::string> names;
+  for (const Space& space : list.spaces()) {
+    names.push_back(space.name);
+  }
+  return names;
+}
+
+TEST(SpaceListTest, NewListHasOnlyADefaultSpace) {
+  SpaceList list;
+  ASSERT_EQ(list.spaces().size(), 1u);
+  const Space& space = list.spaces()[0];
+  EXPECT_TRUE(space.is_default);
+  EXPECT_TRUE(space.id.is_valid());
+  EXPECT_EQ(space.name, kDefaultSpaceName);
+  EXPECT_EQ(&list.default_space(), &space);
+}
+
+TEST(SpaceListTest, RoundTripsEveryField) {
+  SpaceList list;
+  Space work = list.Add("Work", TabGroupColorId::kBlue, "💼");
+  work.isolation = SpaceIsolation::kPartition;
+  work.partition = "space-work";
+  work.last_active = base::Time::FromSecondsSinceUnixEpoch(1700000000);
+  ASSERT_TRUE(list.Update(work));
+
+  SpaceList parsed = SpaceList::FromValue(list.ToValue());
+  EXPECT_EQ(parsed.spaces(), list.spaces());
+}
+
+TEST(SpaceListTest, EmptyValueGetsADefaultSpace) {
+  SpaceList list = SpaceList::FromValue(base::ListValue());
+  ASSERT_EQ(list.spaces().size(), 1u);
+  EXPECT_TRUE(list.spaces()[0].is_default);
+}
+
+TEST(SpaceListTest, MissingDefaultIsAddedAtTheFront) {
+  SpaceList source;
+  source.Add("Work", TabGroupColorId::kBlue, "");
+  base::ListValue value = source.ToValue();
+  value.erase(value.begin());
+
+  SpaceList list = SpaceList::FromValue(value);
+  EXPECT_EQ(Names(list), (std::vector<std::string>{kDefaultSpaceName, "Work"}));
+  EXPECT_TRUE(list.spaces()[0].is_default);
+  EXPECT_FALSE(list.spaces()[1].is_default);
+}
+
+TEST(SpaceListTest, OnlyTheFirstDefaultStaysDefault) {
+  SpaceList source;
+  Space work = source.Add("Work", TabGroupColorId::kBlue, "");
+  base::ListValue value = source.ToValue();
+  value[1].GetDict().Set("default", true);
+
+  SpaceList list = SpaceList::FromValue(value);
+  ASSERT_EQ(list.spaces().size(), 2u);
+  EXPECT_EQ(list.default_space().id, source.default_space().id);
+  EXPECT_FALSE(list.Find(work.id)->is_default);
+}
+
+TEST(SpaceListTest, SkipsInvalidAndDuplicateEntries) {
+  SpaceList source;
+  source.Add("Work", TabGroupColorId::kBlue, "");
+  base::ListValue value = source.ToValue();
+  value.Append("not a dict");
+  value.Append(base::DictValue().Set("name", "No id"));
+  value.Append(base::DictValue().Set("id", "not-a-uuid"));
+  value.Append(value[1].Clone());
+
+  SpaceList list = SpaceList::FromValue(value);
+  EXPECT_EQ(Names(list), (std::vector<std::string>{kDefaultSpaceName, "Work"}));
+}
+
+TEST(SpaceListTest, OutOfRangeFieldsGetDefaults) {
+  SpaceList source;
+  base::ListValue value = source.ToValue();
+  value[0].GetDict().Set("color", 99);
+  value[0].GetDict().Set("isolation", -1);
+
+  SpaceList list = SpaceList::FromValue(value);
+  EXPECT_EQ(list.spaces()[0].color, TabGroupColorId::kGrey);
+  EXPECT_EQ(list.spaces()[0].isolation, SpaceIsolation::kNone);
+}
+
+TEST(SpaceListTest, AddGivesUniqueIds) {
+  SpaceList list;
+  base::Uuid a = list.Add("A", TabGroupColorId::kRed, "").id;
+  base::Uuid b = list.Add("B", TabGroupColorId::kRed, "").id;
+  EXPECT_NE(a, b);
+  EXPECT_NE(a, list.default_space().id);
+  EXPECT_EQ(Names(list),
+            (std::vector<std::string>{kDefaultSpaceName, "A", "B"}));
+}
+
+TEST(SpaceListTest, UpdateKeepsTheDefaultFlag) {
+  SpaceList list;
+  Space space = list.default_space();
+  space.name = "Personal";
+  space.is_default = false;
+  ASSERT_TRUE(list.Update(space));
+  EXPECT_EQ(list.default_space().name, "Personal");
+
+  Space work = list.Add("Work", TabGroupColorId::kBlue, "");
+  work.is_default = true;
+  ASSERT_TRUE(list.Update(work));
+  EXPECT_FALSE(list.Find(work.id)->is_default);
+}
+
+TEST(SpaceListTest, UpdateUnknownSpaceFails) {
+  SpaceList list;
+  Space stranger;
+  stranger.id = base::Uuid::GenerateRandomV4();
+  EXPECT_FALSE(list.Update(stranger));
+}
+
+TEST(SpaceListTest, DefaultSpaceCanNotBeRemoved) {
+  SpaceList list;
+  base::Uuid work = list.Add("Work", TabGroupColorId::kBlue, "").id;
+  EXPECT_FALSE(list.Remove(list.default_space().id));
+  EXPECT_TRUE(list.Remove(work));
+  EXPECT_FALSE(list.Remove(work));
+  EXPECT_EQ(Names(list), (std::vector<std::string>{kDefaultSpaceName}));
+}
+
+TEST(SpaceListTest, MoveReordersAndClamps) {
+  SpaceList list;
+  base::Uuid a = list.Add("A", TabGroupColorId::kRed, "").id;
+  base::Uuid b = list.Add("B", TabGroupColorId::kRed, "").id;
+
+  ASSERT_TRUE(list.Move(b, 0));
+  EXPECT_EQ(Names(list),
+            (std::vector<std::string>{"B", kDefaultSpaceName, "A"}));
+
+  ASSERT_TRUE(list.Move(b, 100));
+  EXPECT_EQ(Names(list),
+            (std::vector<std::string>{kDefaultSpaceName, "A", "B"}));
+
+  ASSERT_TRUE(list.Move(a, 1));
+  EXPECT_EQ(Names(list),
+            (std::vector<std::string>{kDefaultSpaceName, "A", "B"}));
+
+  EXPECT_FALSE(list.Move(base::Uuid::GenerateRandomV4(), 0));
+}
+
+}  // namespace
+
+}  // namespace spaces
