+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_registry.h"
+
+#include <utility>
+
+#include "base/values.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace spaces {
+
+SpaceRegistry::SpaceRegistry(PrefService* prefs)
+    : prefs_(prefs),
+      list_(SpaceList::FromValue(prefs->GetList(prefs::kSpaces))) {
+  // Write back anything FromValue() repaired, most importantly a newly created
+  // default space, so its id stays the same across restarts.
+  base::ListValue value = list_.ToValue();
+  if (value != prefs_->GetList(prefs::kSpaces)) {
+    prefs_->SetList(prefs::kSpaces, std::move(value));
+  }
+}
+
+SpaceRegistry::~SpaceRegistry() = default;
+
+// static
+void SpaceRegistry::RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(prefs::kSpaces);
+}
+
+const Space* SpaceRegistry::GetSpace(const base::Uuid& id) const {
+  return list_.Find(id);
+}
+
+const Space& SpaceRegistry::GetDefaultSpace() const {
+  return list_.default_space();
+}
+
+base::Uuid SpaceRegistry::AddSpace(std::string name,
+                                   tab_groups::TabGroupColorId color,
+                                   std::string icon) {
+  base::Uuid id = list_.Add(std::move(name), color, std::move(icon)).id;
+  SaveAndNotify();
+  return id;
+}
+
+bool SpaceRegistry::UpdateSpace(const Space& space) {
+  const Space* current = list_.Find(space.id);
+  if (!current) {
+    return false;
+  }
+  const Space before = *current;
+  list_.Update(space);
+  if (*list_.Find(space.id) != before) {
+    SaveAndNotify();
+  }
+  return true;
+}
+
+bool SpaceRegistry::RemoveSpace(const base::Uuid& id) {
+  if (!list_.Remove(id)) {
+    return false;
+  }
+  SaveAndNotify();
+  return true;
+}
+
+bool SpaceRegistry::MoveSpace(const base::Uuid& id, size_t index) {
+  const std::vector<Space> before = list_.spaces();
+  if (!list_.Move(id, index)) {
+    return false;
+  }
+  if (list_.spaces() != before) {
+    SaveAndNotify();
+  }
+  return true;
+}
+
+void SpaceRegistry::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SpaceRegistry::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SpaceRegistry::SaveAndNotify() {
+  prefs_->SetList(prefs::kSpaces, list_.ToValue());
+  observers_.Notify(&Observer::OnSpacesChanged);
+}
+
