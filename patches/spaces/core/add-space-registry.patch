+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_LIST_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_LIST_H_
+
+#include <string>
+#include <vector>
+
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "components/tab_groups/tab_group_color.h"
+
+namespace spaces {
+
+// Name given to a new default space. Not localized; strings arrive with the UI.
+inline constexpr char kDefaultSpaceName[] = "Default";
+
+// The ordered spaces of one profile, and the rules that keep them valid: ids
+// are unique and exactly one space is the default. Order is list position.
+class SpaceList {
+ public:
+  // A list holding only a new default space.
+  SpaceList();
+  SpaceList(const SpaceList&);
+  SpaceList& operator=(const SpaceList&);
+  SpaceList(SpaceList&&);
+  SpaceList& operator=(SpaceList&&);
+  ~SpaceList();
+
+  // Parses a list written by ToValue(). Skips entries that don't parse or
+  // repeat an earlier id. The first default entry stays the default; if there
+  // is none, a new default space is added at the front.
+  static SpaceList FromValue(const base::ListValue& value);
+  base::ListValue ToValue() const;
+
+  const std::vector<Space>& spaces() const { return spaces_; }
+  const Space* Find(const base::Uuid& id) const;
+  const Space& default_space() const;
+
+  // Appends a space with a new id and returns it.
+  const Space& Add(std::string name,
+                   tab_groups::TabGroupColorId color,
+                   std::string icon);
+
+  // Replaces the space with `space.id`, keeping its default flag. Returns
+  // false if there is no such space.
+  bool Update(const Space& space);
+
+  // Removes a space. The default space can't be removed. Returns whether a
+  // space was removed.
+  bool Remove(const base::Uuid& id);
+
+  // Moves a space to `index`, clamped to the end of the list. Returns false if
+  // there is no such space.
+  bool Move(const base::Uuid& id, size_t index);
+
+ private:
+  explicit SpaceList(std::vector<Space> spaces);
+
+  std::vector<Space>::iterator FindIterator(const base::Uuid& id);
+
+  std::vector<Space> spaces_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_LIST_H_
