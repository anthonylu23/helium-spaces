+// Copyright 2026 The helium-spaces Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_H_
+
+#include <optional>
+#include <string>
+
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "components/tab_groups/tab_group_color.h"
+
+namespace spaces {
+
+// How a space's tabs are kept apart from other spaces' tabs. Persisted as an
+// int; never renumber.
+enum class SpaceIsolation {
+  // Shares the profile's default storage partition.
+  kNone = 0,
+  // Uses its own StoragePartition: cookies, cache and site storage.
+  kPartition = 1,
+  // Belongs to a separate Profile. Reserved, not implemented yet.
+  kProfile = 2,
+  kMaxValue = kProfile,
+};
+
+// A named, colored set of tabs. Tabs refer to a space by `id`.
+struct Space {
+  Space();
+  Space(const Space&);
+  Space& operator=(const Space&);
+  Space(Space&&);
+  Space& operator=(Space&&);
+  ~Space();
+
+  // Parses a space written by ToValue(). Returns nullopt if the id is missing
+  // or invalid. Other missing or invalid fields get their defaults.
+  static std::optional<Space> FromValue(const base::DictValue& value);
+  base::DictValue ToValue() const;
+
+  friend bool operator==(const Space&, const Space&) = default;
+
+  // Unique across profiles, so a space can later move to another profile.
+  base::Uuid id;
+  std::string name;
+  tab_groups::TabGroupColorId color = tab_groups::TabGroupColorId::kGrey;
+  // An emoji or symbol name shown in the switcher. Empty means none.
+  std::string icon;
+  SpaceIsolation isolation = SpaceIsolation::kNone;
+  // StoragePartition name. Only used with SpaceIsolation::kPartition.
+  std::string partition;
+  base::Time last_active;
+  // The profile's permanent space. Tabs with no space id, or with the id of a
+  // removed space, belong to it.
+  bool is_default = false;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_H_
