+#ifndef CHROME_BROWSER_UI_SPACES_SPACES_FEATURES_H_
+#define CHROME_BROWSER_UI_SPACES_SPACES_FEATURES_H_
+
+#include "base/feature_list.h"
+
+namespace spaces::features {
+
+// Gates every helium-spaces feature: Spaces, per-space isolation, and the tab
+// organization features. Disabled by default until each piece is usable.
+BASE_DECLARE_FEATURE(kHeliumSpaces);
+
+// Whether helium-spaces features should be active in this browser session.
+bool IsSpacesEnabled();
+
+}  // namespace spaces::features
