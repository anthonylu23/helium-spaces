+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_switcher_drop_target.h"
+
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/ui/spaces/space_controller.h"
+#include "chrome/browser/ui/views/frame/tab_strip_region_view.h"
+#include "chrome/browser/ui/views/spaces/space_switcher_view.h"
+#include "chrome/browser/ui/views/tabs/dragging/drag_session_data.h"
+#include "components/tabs/public/tab_interface.h"
+
+namespace spaces {
+
+SpaceSwitcherDropTarget::SpaceSwitcherDropTarget(
+    SpaceSwitcherView* switcher,
+    TabStripRegionView* region,
+    BrowserWindowInterface* browser)
+    : switcher_(switcher), region_(region), browser_(browser) {}
+
+SpaceSwitcherDropTarget::~SpaceSwitcherDropTarget() {
+  on_will_destroy_callbacks_.Notify();
+}
+
+bool SpaceSwitcherDropTarget::Contains(
+    const gfx::Point& point_in_screen) const {
+  return switcher_->IsDrawn() &&
+         switcher_->GetSpaceAtPoint(point_in_screen).has_value();
+}
+
+void SpaceSwitcherDropTarget::OnTabDragEntered() {}
+
+TabDragContext* SpaceSwitcherDropTarget::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  SetHoveredSpace(switcher_->GetSpaceAtPoint(point_in_screen));
+  // Stay attached to this window, or attach to it, as its tab strip does.
+  return region_->GetDragContext();
+}
+
+void SpaceSwitcherDropTarget::OnTabDragExited(
+    const gfx::Point& point_in_screen) {
+  SetHoveredSpace(std::nullopt);
+}
+
+void SpaceSwitcherDropTarget::OnTabDragEnded() {
+  SetHoveredSpace(std::nullopt);
+}
+
+bool SpaceSwitcherDropTarget::CanDropTab() {
+  return hovered_space_id_.has_value();
+}
+
+void SpaceSwitcherDropTarget::HandleTabDrop(
+    TabDragTarget::DragController& controller) {
+  SpaceController* space_controller = SpaceController::From(browser_);
+  if (!space_controller || !hovered_space_id_) {
+    return;
+  }
+  const DragSessionData& data = controller.GetSessionData();
+  std::vector<tabs::TabHandle> tabs;
+  for (const TabDragData& tab_data : data.tab_drag_data_) {
+    if (!tab_data.contents) {
+      continue;  // The group header.
+    }
+    if (tabs::TabInterface* tab =
+            tabs::TabInterface::MaybeGetFromContents(tab_data.contents)) {
+      tabs.push_back(tab->GetHandle());
+    }
+  }
+  space_controller->MoveDroppedTabsToSpace(
+      std::move(tabs),
+      data.group_header_drag_data_
+          ? std::optional(data.group_header_drag_data_->group)
+          : std::nullopt,
+      *hovered_space_id_);
+  SetHoveredSpace(std::nullopt);
+}
+
+base::CallbackListSubscription
+SpaceSwitcherDropTarget::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return on_will_destroy_callbacks_.Add(std::move(callback));
+}
+
+void SpaceSwitcherDropTarget::SetHoveredSpace(
+    std::optional<base::Uuid> space_id) {
+  hovered_space_id_ = space_id;
+  switcher_->SetDropTarget(space_id);
+}
