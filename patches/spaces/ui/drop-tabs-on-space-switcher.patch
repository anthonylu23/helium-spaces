+void SpaceController::MoveGroupToSpace(tab_groups::TabGroupId group,
+                                       const base::Uuid& space_id) {
+  if (!tab_strip_model_->group_model() ||
+      !tab_strip_model_->group_model()->ContainsTabGroup(group)) {
+    return;
+  }
+  const base::Uuid space = ResolveSpace(space_id);
+  const gfx::Range range =
+      tab_strip_model_->group_model()->GetTabGroup(group)->ListTabs();
+  std::vector<tabs::TabInterface*> moving;
+  for (size_t index = range.start(); index < range.end(); ++index) {
+    moving.push_back(tab_strip_model_->GetTabAtIndex(index));
+  }
+  if (moving.empty() || GetSpaceOfTab(moving.front()) == space) {
+    return;
+  }
+  const bool was_active =
+      std::ranges::contains(moving, tab_strip_model_->GetActiveTab());
+  for (tabs::TabInterface* tab : moving) {
+    SetTabSpace(tab->GetContents(), space);
+  }
+  // As in MoveTabToSpace(), the end of the tab strip is the end of the
+  // space's tabs.
+  tab_strip_model_->MoveGroupTo(
+      group, tab_strip_model_->count() - static_cast<int>(moving.size()));
+  if (was_active && !IsTabInActiveSpace(tab_strip_model_->GetActiveTab())) {
+    ActivateTabInActiveSpace();
+  }
+  tab_visibility_changed_callbacks_.Notify();
+}
+
+void SpaceController::MoveDroppedTabsToSpace(
+    std::vector<tabs::TabHandle> tabs,
+    std::optional<tab_groups::TabGroupId> group,
+    const base::Uuid& space_id) {
+  // The tab strip finishes the drag first, laying the tabs out where they
+  // were dropped.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<SpaceController> controller,
+             std::vector<tabs::TabHandle> tabs,
+             std::optional<tab_groups::TabGroupId> group, base::Uuid space_id) {
+            if (!controller) {
+              return;
+            }
+            if (group) {
+              controller->MoveGroupToSpace(*group, space_id);
+              return;
+            }
+            for (const tabs::TabHandle& handle : tabs) {
+              tabs::TabInterface* tab = handle.Get();
+              if (tab && controller->tab_strip_model_->GetIndexOfTab(tab) !=
+                             TabStripModel::kNoTab) {
+                controller->MoveTabToSpace(tab, space_id);
+              }
+            }
+          },
+          weak_factory_.GetWeakPtr(), std::move(tabs), group, space_id));
+}
