+
+#ifndef CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_DROP_TARGET_H_
+#define CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_DROP_TARGET_H_
+
+#include <optional>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/uuid.h"
+#include "chrome/browser/ui/views/tabs/dragging/tab_drag_target.h"
+
+class BrowserWindowInterface;
+class TabStripRegionView;
+
+namespace spaces {
+
+class SpaceSwitcherView;
+
+// Lets tabs dragged over a space's icon in the switcher be dropped there, to
+// move them to that space, as in Arc. Over an icon, the tabs stay attached to
+// the window rather than being torn off into a new one.
+class SpaceSwitcherDropTarget : public TabDragTarget {
+ public:
+  SpaceSwitcherDropTarget(SpaceSwitcherView* switcher,
+                          TabStripRegionView* region,
+                          BrowserWindowInterface* browser);
+  SpaceSwitcherDropTarget(const SpaceSwitcherDropTarget&) = delete;
+  SpaceSwitcherDropTarget& operator=(const SpaceSwitcherDropTarget&) = delete;
+  ~SpaceSwitcherDropTarget() override;
+
+  // Whether `point_in_screen` is over a space's icon.
+  bool Contains(const gfx::Point& point_in_screen) const;
+
+  // TabDragTarget:
+  void OnTabDragEntered() override;
+  TabDragContext* OnTabDragUpdated(TabDragTarget::DragController& controller,
+                                   const gfx::Point& point_in_screen) override;
+  void OnTabDragExited(const gfx::Point& point_in_screen) override;
+  void OnTabDragEnded() override;
+  bool CanDropTab() override;
+  void HandleTabDrop(TabDragTarget::DragController& controller) override;
+  base::CallbackListSubscription RegisterWillDestroyCallback(
+      base::OnceClosure callback) override;
+
+ private:
+  void SetHoveredSpace(std::optional<base::Uuid> space_id);
+
+  const raw_ptr<SpaceSwitcherView> switcher_;
+  const raw_ptr<TabStripRegionView> region_;
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::optional<base::Uuid> hovered_space_id_;
+  base::OnceClosureList on_will_destroy_callbacks_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_DROP_TARGET_H_
