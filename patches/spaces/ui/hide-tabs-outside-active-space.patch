 bool TabStripLayoutHelper::SlotIsCollapsedTab(int i) const {
+  // helium-spaces: Tabs outside the active space collapse like tabs outside a
+  // focused group, pinned ones too, and so does the header of a group of them.
+  // A group's tabs are all in one space, and its header comes first.
+  const int tab_slot =
+      slots_[i].type == TabSlotView::ViewType::kTabGroupHeader ? i + 1 : i;
+  if (tab_slot < static_cast<int>(slots_.size()) &&
+      slots_[tab_slot].type == TabSlotView::ViewType::kTab &&
+      slots_[tab_slot].view->group() == slots_[i].view->group() &&
+      spaces::IsTabHiddenBySpace(
+          static_cast<Tab*>(slots_[tab_slot].view)->tab_handle().Get())) {
+    return true;
+  }
+
   const std::optional<tab_groups::TabGroupId> focused_group =
       controller_->GetFocusedGroup();
 
