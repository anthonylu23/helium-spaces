+namespace {
+
+// The first tab shown by `child`, or null if it has none.
+const tabs::TabInterface* GetFirstTab(const views::View* child) {
+  if (const auto* tab_view = views::AsViewClass<TabView>(child)) {
+    return tab_view->GetTabInterface();
+  }
+  if (const auto* group_view = views::AsViewClass<TabGroupView>(child)) {
+    return group_view->GetTabGroup().GetFirstTab();
+  }
+  if (views::IsViewClass<SplitTabView>(child)) {
+    for (const views::View* split_child : child->children()) {
+      if (const auto* tab_view = views::AsViewClass<TabView>(split_child)) {
+        return tab_view->GetTabInterface();
+      }
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+bool IsTabContainerChildHiddenBySpace(const views::View* child) {
+  return IsTabHiddenBySpace(GetFirstTab(child));
+}
+
+}  // namespace spaces
