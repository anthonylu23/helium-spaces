+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kSpaceNameFieldId);
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kSpaceIconFieldId);
+
+// Long enough for any emoji sequence, short enough to stay an icon.
+constexpr size_t kMaxIconBytes = 32;
+constexpr int kSwatchSize = 24;
+constexpr int kSwatchSpacing = 6;
+
+// One color of the palette, a circle, ringed while selected.
+class SpaceColorSwatch : public views::Button {
+  METADATA_HEADER(SpaceColorSwatch, views::Button)
+
+ public:
+  SpaceColorSwatch(PressedCallback callback,
+                   tab_groups::TabGroupColorId color,
+                   const std::u16string& label)
+      : views::Button(std::move(callback)), color_(color) {
+    SetTooltipText(label);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kRadioButton);
+    GetViewAccessibility().SetName(label);
+    SetSelected(false);
+  }
+
+  tab_groups::TabGroupColorId color() const { return color_; }
+
+  void SetSelected(bool selected) {
+    selected_ = selected;
+    GetViewAccessibility().SetCheckedState(
+        selected ? ax::mojom::CheckedState::kTrue
+                 : ax::mojom::CheckedState::kFalse);
+    SchedulePaint();
+  }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kSwatchSize, kSwatchSize);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const gfx::RectF bounds(GetLocalBounds());
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(GetColorProvider()->GetColor(
+        GetTabGroupTabStripColorId(color_, /*active_frame=*/true)));
+    canvas->DrawCircle(bounds.CenterPoint(),
+                       kSwatchSize / 2 - (selected_ ? 4 : 2), flags);
+    if (selected_) {
+      flags.setStyle(cc::PaintFlags::kStroke_Style);
+      flags.setStrokeWidth(2);
+      canvas->DrawCircle(bounds.CenterPoint(), kSwatchSize / 2 - 1, flags);
+    }
+  }
+
+ private:
+  const tab_groups::TabGroupColorId color_;
+  bool selected_ = false;
+};
+
+BEGIN_METADATA(SpaceColorSwatch)
+END_METADATA
+
+// The tab group palette as a row of swatches, one selected.
+class SpaceColorPicker : public views::View {
+  METADATA_HEADER(SpaceColorPicker, views::View)
+
+ public:
+  explicit SpaceColorPicker(tab_groups::TabGroupColorId selected) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+        kSwatchSpacing));
+    const tab_groups::ColorLabelMap labels =
+        tab_groups::GetTabGroupColorLabelMap();
+    for (const tab_groups::TabGroupColorId color :
+         TabGroupModel::GetColorOrdering()) {
+      AddChildView(std::make_unique<SpaceColorSwatch>(
+          base::BindRepeating(&SpaceColorPicker::Select, base::Unretained(this),
+                              color),
+          color, labels.at(color)));
+    }
+    Select(selected);
+  }
+
+  tab_groups::TabGroupColorId selected() const { return selected_; }
+
+ private:
+  void Select(tab_groups::TabGroupColorId color) {
+    selected_ = color;
+    for (views::View* child : children()) {
+      auto* swatch = static_cast<SpaceColorSwatch*>(child);
+      swatch->SetSelected(swatch->color() == color);
+    }
+  }
+
+  tab_groups::TabGroupColorId selected_;
+};
+
+BEGIN_METADATA(SpaceColorPicker)
+END_METADATA
+
+void Save(SpaceRegistry* registry,
+          base::Uuid space_id,
+          ui::DialogModelDelegate* delegate,
+          SpaceColorPicker* color_picker) {
+  const Space* current = registry->GetSpace(space_id);
+  if (!current) {
+    return;
+  }
+  Space space = *current;
+  ui::DialogModel* model = delegate->dialog_model();
+  const std::u16string name = base::CollapseWhitespace(
+      model->GetTextfieldByUniqueId(kSpaceNameFieldId)->text(),
+      /*trim_sequences_with_line_breaks=*/true);
+  if (!name.empty()) {
+    space.name = base::UTF16ToUTF8(name);
+  }
+  std::u16string icon;
+  base::TrimWhitespace(model->GetTextfieldByUniqueId(kSpaceIconFieldId)->text(),
+                       base::TRIM_ALL, &icon);
+  // Cut at a character boundary, never inside one.
+  base::TruncateUTF8ToByteSize(base::UTF16ToUTF8(icon), kMaxIconBytes,
+                               &space.icon);
+  space.color = color_picker->selected();
+  registry->UpdateSpace(space);
+}
+
+}  // namespace
+
+void ShowSpaceSettingsBubble(views::View* anchor,
+                             SpaceRegistry* registry,
+                             const base::Uuid& space_id) {
+  const Space* space = registry->GetSpace(space_id);
+  if (!space || !anchor->GetWidget()) {
+    return;
+  }
+  auto color_picker = std::make_unique<SpaceColorPicker>(space->color);
+  SpaceColorPicker* color_picker_ptr = color_picker.get();
+  auto delegate = std::make_unique<ui::DialogModelDelegate>();
+  ui::DialogModelDelegate* delegate_ptr = delegate.get();
+
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(l10n_util::GetStringUTF16(IDS_SPACES_SETTINGS_TITLE))
+          .AddTextfield(kSpaceNameFieldId,
+                        l10n_util::GetStringUTF16(IDS_SPACES_SETTINGS_NAME),
+                        base::UTF8ToUTF16(space->name))
+          .AddTextfield(kSpaceIconFieldId,
+                        l10n_util::GetStringUTF16(IDS_SPACES_SETTINGS_ICON),
+                        base::UTF8ToUTF16(space->icon))
+          .AddCustomField(
+              std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                  std::move(color_picker),
+                  views::BubbleDialogModelHost::FieldType::kControl))
+          .AddOkButton(base::BindOnce(&Save, registry, space_id, delegate_ptr,
+                                      color_picker_ptr),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           l10n_util::GetStringUTF16(IDS_DONE)))
+          .AddCancelButton(base::DoNothing())
+          .SetInitiallyFocusedField(kSpaceNameFieldId)
+          .Build();
+
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::BOTTOM_LEFT);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
+
