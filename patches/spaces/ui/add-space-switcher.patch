+// static
+SpaceSwitcherView* SpaceSwitcherView::MaybeAdd(
+    views::View* parent,
+    TabStripRegionView* region,
+    BrowserWindowInterface* browser) {
+  if (!SpaceController::From(browser)) {
+    return nullptr;
+  }
+  return parent->AddChildView(std::make_unique<SpaceSwitcherView>(
+      region, browser,
+      SpaceRegistryFactory::GetForProfile(browser->GetProfile())));
+}
+
+SpaceSwitcherView::SpaceSwitcherView(TabStripRegionView* region,
+                                     BrowserWindowInterface* browser,
+                                     SpaceRegistry* registry)
+    : region_(region), browser_(browser), registry_(registry) {
+  GetViewAccessibility().SetRole(ax::mojom::Role::kTabList);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_SPACES_SWITCHER_ACCESSIBLE_NAME));
+
+  auto add_button = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&SpaceSwitcherView::AddSpace, base::Unretained(this)),
+      kAddIcon, 16);
+  add_button->SetTooltipText(
+      l10n_util::GetStringUTF16(IDS_SPACES_SWITCHER_NEW_SPACE));
+  views::InstallRoundRectHighlightPathGenerator(add_button.get(), gfx::Insets(),
+                                                kCornerRadius);
+  add_button_ = AddChildView(std::move(add_button));
+
+  if (auto* state = tabs::VerticalTabStripStateController::From(browser)) {
+    collapsed_ = state->IsCollapsed();
+    collapse_subscription_ = state->RegisterOnCollapseChanged(
+        base::BindRepeating(&SpaceSwitcherView::OnCollapseStateChanged,
+                            base::Unretained(this)));
+  }
+  visibility_subscription_ =
+      SpaceController::From(browser)->RegisterTabVisibilityChanged(
+          base::BindRepeating(&SpaceSwitcherView::UpdateActive,
+                              base::Unretained(this)));
+  registry_observation_.Observe(registry_);
+  Rebuild();
+}
+
+SpaceSwitcherView::~SpaceSwitcherView() = default;
+
+std::optional<base::Uuid> SpaceSwitcherView::GetSpaceAtPoint(
+    const gfx::Point& point_in_screen) const {
+  for (SpaceSwitcherButton* button : buttons_) {
+    if (button->IsDrawn() &&
+        button->GetBoundsInScreen().Contains(point_in_screen)) {
+      return button->space().id;
+    }
+  }
+  return std::nullopt;
+}
+
+void SpaceSwitcherView::SetDropTarget(std::optional<base::Uuid> space_id) {
+  for (SpaceSwitcherButton* button : buttons_) {
+    button->SetDropTarget(button->space().id == space_id);
+  }
+}
+
+gfx::Size SpaceSwitcherView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int count = collapsed_ ? 1 : buttons_.size() + 1;
+  return gfx::Size(count * kButtonSize, kButtonSize + 2 * kVerticalPadding);
+}
+
+void SpaceSwitcherView::Layout(PassKey) {
+  const gfx::Rect bounds = GetContentsBounds();
+  const int y = bounds.y() + kVerticalPadding;
+  SpaceController* controller = GetController();
+  const base::Uuid active =
+      controller ? controller->active_space_id() : base::Uuid();
+
+  showing_only_active_ = collapsed_;
+  if (collapsed_) {
+    add_button_->SetVisible(false);
+    for (SpaceSwitcherButton* button : buttons_) {
+      const bool is_active = button->space().id == active;
+      button->SetVisible(is_active);
+      if (is_active) {
+        button->SetBounds(bounds.x() + (bounds.width() - kButtonSize) / 2, y,
+                          kButtonSize, kButtonSize);
+      }
+    }
+    return;
+  }
+
+  // "+" at the end, and the spaces centered in the rest, shrinking to dots,
+  // then to the active space alone if even dots don't fit.
+  add_button_->SetVisible(true);
+  add_button_->SetBounds(bounds.right() - kButtonSize, y, kButtonSize,
+                         kButtonSize);
+  const int available = bounds.width() - kButtonSize;
+  const int count = buttons_.size();
+  if (count == 0) {
+    return;
+  }
+  int width = std::min(kButtonSize, available / count);
+  const bool fits = width >= kMinDotWidth;
+  if (!fits) {
+    width = kButtonSize;
+  }
+  const int shown = fits ? count : 1;
+  showing_only_active_ = !fits;
+  int x = bounds.x() + (available - shown * width) / 2;
+  for (SpaceSwitcherButton* button : buttons_) {
+    const bool visible = fits || button->space().id == active;
+    button->SetVisible(visible);
+    if (visible) {
+      button->SetBounds(x, y, width, kButtonSize);
+      x += width;
+    }
+  }
+}
+
+void SpaceSwitcherView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto* button = static_cast<SpaceSwitcherButton*>(source);
+  menu_space_id_ = button->space().id;
+  auto model = std::make_unique<ui::SimpleMenuModel>(this);
+  model->AddItemWithStringId(kEditSpaceCommand, IDS_SPACES_SWITCHER_EDIT_SPACE);
+  model->AddItemWithStringId(kDeleteSpaceCommand,
+                             IDS_SPACES_SWITCHER_DELETE_SPACE);
+  RunMenu(std::move(model), source, source_type);
+}
+
+void SpaceSwitcherView::ExecuteCommand(int command_id, int event_flags) {
+  SpaceController* controller = GetController();
+  if (!controller) {
+    return;
+  }
+  switch (command_id) {
+    case kNewSpaceCommand:
+      AddSpace();
+      return;
+    case kEditSpaceCommand:
+      if (menu_space_id_) {
+        ShowSettingsBubble(*menu_space_id_);
+      }
+      return;
+    case kDeleteSpaceCommand:
+      if (menu_space_id_) {
+        registry_->RemoveSpace(*menu_space_id_);
+      }
+      return;
+  }
+  if (command_id >= 0 &&
+      static_cast<size_t>(command_id) < registry_->spaces().size()) {
+    controller->SwitchToSpace(registry_->spaces()[command_id].id);
+  }
+}
+
+bool SpaceSwitcherView::IsCommandIdChecked(int command_id) const {
+  SpaceController* controller = GetController();
+  return controller && command_id >= 0 &&
+         static_cast<size_t>(command_id) < registry_->spaces().size() &&
+         registry_->spaces()[command_id].id == controller->active_space_id();
+}
+
+bool SpaceSwitcherView::IsCommandIdEnabled(int command_id) const {
+  if (command_id == kDeleteSpaceCommand) {
+    const Space* space =
+        menu_space_id_ ? registry_->GetSpace(*menu_space_id_) : nullptr;
+    return space && !space->is_default;
+  }
+  return true;
+}
+
+void SpaceSwitcherView::MenuClosed(ui::SimpleMenuModel* menu) {
+  expand_on_hover_lock_.reset();
+}
+
+void SpaceSwitcherView::OnSpacesChanged() {
+  Rebuild();
+}
+
+SpaceController* SpaceSwitcherView::GetController() const {
+  return SpaceController::From(browser_);
+}
+
+void SpaceSwitcherView::Rebuild() {
+  // Cleared before they are destroyed, so no pointer dangles.
+  std::vector<SpaceSwitcherButton*> old_buttons(buttons_.begin(),
+                                                buttons_.end());
+  buttons_.clear();
+  for (SpaceSwitcherButton* button : old_buttons) {
+    RemoveChildViewT(button);
+  }
+  for (const Space& space : registry_->spaces()) {
+    auto button = std::make_unique<SpaceSwitcherButton>(
+        base::BindRepeating(&SpaceSwitcherView::OnSpaceButtonPressed,
+                            base::Unretained(this), space.id),
+        space);
+    button->set_context_menu_controller(this);
+    buttons_.push_back(AddChildViewAt(std::move(button), buttons_.size()));
+  }
+  UpdateActive();
+  PreferredSizeChanged();
+}
+
+void SpaceSwitcherView::UpdateActive() {
+  SpaceController* controller = GetController();
+  if (!controller) {
+    return;
+  }
+  for (SpaceSwitcherButton* button : buttons_) {
+    button->SetActive(button->space().id == controller->active_space_id());
+  }
+  InvalidateLayout();
+}
+
+void SpaceSwitcherView::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  // Updated at the start of the animation, as the bottom container is.
+  collapsed_ = state != tabs::VerticalTabStripCollapseState::kExpanded;
+  PreferredSizeChanged();
+}
+
+void SpaceSwitcherView::OnSpaceButtonPressed(const base::Uuid& space_id) {
+  SpaceController* controller = GetController();
+  if (!controller) {
+    return;
+  }
+  if (!showing_only_active_) {
+    controller->SwitchToSpace(space_id);
+    return;
+  }
+  // When it is the only icon shown, it lists the spaces.
+  menu_space_id_.reset();
+  auto model = std::make_unique<ui::SimpleMenuModel>(this);
+  for (size_t i = 0; i < registry_->spaces().size(); ++i) {
+    const Space& space = registry_->spaces()[i];
+    model->AddCheckItem(
+        i,
+        base::UTF8ToUTF16(space.icon.empty() ? space.name
+                                             : space.icon + " " + space.name));
+    model->SetMayHaveMnemonicsAt(i, false);
+  }
+  model->AddSeparator(ui::NORMAL_SEPARATOR);
+  model->AddItemWithStringId(kNewSpaceCommand, IDS_SPACES_SWITCHER_NEW_SPACE);
+  RunMenu(std::move(model), GetButton(space_id),
+          ui::mojom::MenuSourceType::kMouse);
+}
+
+void SpaceSwitcherView::AddSpace() {
+  SpaceController* controller = GetController();
+  if (!controller) {
+    return;
+  }
+  // The next color of the tab group palette, so neighbors differ.
+  const std::vector<tab_groups::TabGroupColorId>& colors =
+      TabGroupModel::GetColorOrdering();
+  const size_t count = registry_->spaces().size();
+  const base::Uuid id = registry_->AddSpace(
+      l10n_util::GetStringFUTF8(IDS_SPACES_NEW_SPACE_NAME,
+                                base::NumberToString16(count + 1)),
+      colors[count % colors.size()], std::string());
+  controller->SwitchToSpace(id);
+  ShowSettingsBubble(id);
+}
+
+void SpaceSwitcherView::ShowSettingsBubble(const base::Uuid& space_id) {
+  views::View* anchor = GetButton(space_id);
+  if (!anchor || !anchor->GetVisible()) {
+    anchor = this;
+  }
+  ShowSpaceSettingsBubble(anchor, registry_, space_id);
+}
+
+void SpaceSwitcherView::RunMenu(std::unique_ptr<ui::SimpleMenuModel> model,
+                                views::View* anchor,
+                                ui::mojom::MenuSourceType source_type) {
+  if (!anchor) {
+    return;
+  }
+  // The old runner goes before the model it shows.
+  menu_runner_.reset();
+  menu_model_ = std::move(model);
+  expand_on_hover_lock_ =
+      region_->GetExpandOnHoverLock(ExpandOnHoverLockType::kKeepCurrentState);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, anchor->GetBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+SpaceSwitcherButton* SpaceSwitcherView::GetButton(
+    const base::Uuid& space_id) const {
+  for (SpaceSwitcherButton* button : buttons_) {
+    if (button->space().id == space_id) {
+      return button;
+    }
+  }
+  return nullptr;
+}
