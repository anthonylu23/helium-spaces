+
+// The row of space icons at the bottom of the vertical tab strip, as in Arc:
+// click one to switch to its space, right-click to edit or delete it, and "+"
+// to add a space. Icons shrink to dots when they don't fit. In the collapsed
+// tab strip, or when even dots don't fit, only the active space's icon shows,
+// and clicking it lists the spaces in a menu.
+class SpaceSwitcherView : public views::View,
+                          public views::ContextMenuController,
+                          public ui::SimpleMenuModel::Delegate,
+                          public SpaceRegistry::Observer {
+  METADATA_HEADER(SpaceSwitcherView, views::View)
+
+ public:
+  // Adds a switcher to `parent` if `browser` shows spaces, and returns it.
+  // `region` is the vertical tab strip, kept expanded while a menu is open.
+  static SpaceSwitcherView* MaybeAdd(views::View* parent,
+                                     TabStripRegionView* region,
+                                     BrowserWindowInterface* browser);
+
+  SpaceSwitcherView(TabStripRegionView* region,
+                    BrowserWindowInterface* browser,
+                    SpaceRegistry* registry);
+  SpaceSwitcherView(const SpaceSwitcherView&) = delete;
+  SpaceSwitcherView& operator=(const SpaceSwitcherView&) = delete;
+  ~SpaceSwitcherView() override;
+
+  // The space whose icon contains `point_in_screen`, or nullopt.
+  std::optional<base::Uuid> GetSpaceAtPoint(
+      const gfx::Point& point_in_screen) const;
+
+  // Highlights the icon of `space_id`, or none, while tabs are dragged over
+  // it.
+  void SetDropTarget(std::optional<base::Uuid> space_id);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+  bool IsCommandIdChecked(int command_id) const override;
+  bool IsCommandIdEnabled(int command_id) const override;
+  void MenuClosed(ui::SimpleMenuModel* menu) override;
+
+  // SpaceRegistry::Observer:
+  void OnSpacesChanged() override;
+
+ private:
+  SpaceController* GetController() const;
+
+  // Recreates the icons from the registry.
+  void Rebuild();
+  // Marks the active space's icon, and shows only it while collapsed.
+  void UpdateActive();
+  void OnCollapseStateChanged(tabs::VerticalTabStripCollapseState state);
+
+  void OnSpaceButtonPressed(const base::Uuid& space_id);
+  void AddSpace();
+  void ShowSettingsBubble(const base::Uuid& space_id);
+  void RunMenu(std::unique_ptr<ui::SimpleMenuModel> model,
+               views::View* anchor,
+               ui::mojom::MenuSourceType source_type);
+  SpaceSwitcherButton* GetButton(const base::Uuid& space_id) const;
+
+  const raw_ptr<TabStripRegionView> region_;
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<SpaceRegistry> registry_;
+
+  std::vector<raw_ptr<SpaceSwitcherButton>> buttons_;
+  raw_ptr<views::Button> add_button_ = nullptr;
+  bool collapsed_ = false;
+  // Whether only the active space's icon shows: collapsed, or too many
+  // spaces for even dots. Clicking it then opens a menu of the spaces.
+  bool showing_only_active_ = false;
+
+  // The space a context menu is open for, or the spaces menu if none.
+  std::optional<base::Uuid> menu_space_id_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  std::unique_ptr<ExpandOnHoverLock> expand_on_hover_lock_;
+
+  base::ScopedObservation<SpaceRegistry, SpaceRegistry::Observer>
+      registry_observation_{this};
+  base::CallbackListSubscription visibility_subscription_;
+  base::CallbackListSubscription collapse_subscription_;
+};
+
