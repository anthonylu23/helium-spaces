+namespace spaces {
+
+namespace {
+
+// The size of a space's icon, and of the "+" button.
+constexpr int kButtonSize = 28;
+// Below this width, icons become dots.
+constexpr int kMinIconWidth = 22;
+// Narrower icons than this don't fit at all; the active one stays shown.
+constexpr int kMinDotWidth = 8;
+constexpr int kDotRadius = 3;
+constexpr int kLargeDotRadius = 5;
+constexpr int kCornerRadius = 6;
+constexpr int kVerticalPadding = 2;
+
+// Spaces menu commands, past the spaces' indices.
+constexpr int kNewSpaceCommand = 1000;
+constexpr int kEditSpaceCommand = 1001;
+constexpr int kDeleteSpaceCommand = 1002;
+
+}  // namespace
+
+// One space's icon: its emoji, or a dot in its color. The active space's icon
+// sits on a background of its color.
+class SpaceSwitcherButton : public views::Button {
+  METADATA_HEADER(SpaceSwitcherButton, views::Button)
+
+ public:
+  SpaceSwitcherButton(PressedCallback callback, const Space& space)
+      : views::Button(std::move(callback)), space_(space) {
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                  kCornerRadius);
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+    SetHasInkDropActionOnClick(true);
+    SetTooltipText(base::UTF8ToUTF16(space.name));
+    GetViewAccessibility().SetName(base::UTF8ToUTF16(space.name));
+  }
+
+  const Space& space() const { return space_; }
+
+  void SetActive(bool active) {
+    if (active_ == active) {
+      return;
+    }
+    active_ = active;
+    GetViewAccessibility().SetIsSelected(active);
+    SchedulePaint();
+  }
+
+  void SetDropTarget(bool drop_target) {
+    if (drop_target_ == drop_target) {
+      return;
+    }
+    drop_target_ = drop_target;
+    SchedulePaint();
+  }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kButtonSize, kButtonSize);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    const SkColor color =
+        colors->GetColor(GetTabGroupTabStripColorId(space_.color,
+                                                    /*active_frame=*/true));
+    const gfx::RectF bounds(GetContentsBounds());
+    const bool dot = width() < kMinIconWidth;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    if ((active_ || drop_target_) && !dot) {
+      flags.setColor(SkColorSetA(color, drop_target_ ? 0x80 : 0x40));
+      canvas->DrawRoundRect(bounds, kCornerRadius, flags);
+    }
+    if (dot || space_.icon.empty()) {
+      flags.setColor(active_ || !dot ? color : SkColorSetA(color, 0x99));
+      canvas->DrawCircle(bounds.CenterPoint(),
+                         dot && (active_ || drop_target_) ? kLargeDotRadius
+                         : dot                            ? kDotRadius
+                                                          : kLargeDotRadius,
+                         flags);
+      return;
+    }
+    canvas->DrawStringRectWithFlags(
+        base::UTF8ToUTF16(space_.icon), gfx::FontList().DeriveWithSizeDelta(2),
+        color, GetContentsBounds(), gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  const Space space_;
+  bool active_ = false;
+  bool drop_target_ = false;
+};
