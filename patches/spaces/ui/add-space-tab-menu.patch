+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_controller.h"
+#include "chrome/browser/ui/tabs/tab_group_theme.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/models/list_selection_model.h"
+
+namespace spaces {
+
+namespace {
+
+constexpr int kSpaceIconSize = 14;
+
+SpaceController* GetController(TabStripModel* tab_strip) {
+  BrowserWindowInterface* browser =
+      tab_strip->delegate() ? tab_strip->delegate()->GetBrowserWindowInterface()
+                            : nullptr;
+  return browser ? SpaceController::From(browser) : nullptr;
+}
+
+std::u16string GetLabel(const Space& space) {
+  return base::UTF8ToUTF16(space.icon.empty() ? space.name
+                                              : space.icon + " " + space.name);
+}
+
+}  // namespace
+
+std::vector<tabs::TabInterface*> GetTabsForMenuCommand(TabStripModel* tab_strip,
+                                                       int context_index) {
+  if (!tab_strip->ContainsIndex(context_index)) {
+    return {};
+  }
+  if (!tab_strip->IsTabSelected(context_index)) {
+    return {tab_strip->GetTabAtIndex(context_index)};
+  }
+  std::vector<tabs::TabInterface*> tabs;
+  for (size_t index : tab_strip->selection_model()
+                          .GetListSelectionModel()
+                          .selected_indices()) {
+    tabs.push_back(tab_strip->GetTabAtIndex(index));
+  }
+  return tabs;
+}
+
+std::optional<int> GetPinMenuItemStringId(TabStripModel* tab_strip,
+                                          int context_index,
+                                          bool will_pin) {
+  SpaceController* controller = GetController(tab_strip);
+  const std::vector<tabs::TabInterface*> menu_tabs =
+      GetTabsForMenuCommand(tab_strip, context_index);
+  if (!controller || menu_tabs.empty()) {
+    return std::nullopt;
+  }
+  // Only when every tab the item acts on would leave the favorites.
+  if (!will_pin &&
+      std::ranges::all_of(menu_tabs, [&](const tabs::TabInterface* tab) {
+        return controller->IsFavorite(tab);
+      })) {
+    return IDS_SPACES_TAB_CXMENU_REMOVE_FROM_FAVORITES;
+  }
+  return std::nullopt;
+}
+
+bool ShouldShowAddToFavorites(TabStripModel* tab_strip, int context_index) {
+  SpaceController* controller = GetController(tab_strip);
+  return controller && tab_strip->ContainsIndex(context_index) &&
+         !controller->IsFavorite(tab_strip->GetTabAtIndex(context_index));
+}
+
+// static
+std::unique_ptr<MoveToSpaceSubMenuModel> MoveToSpaceSubMenuModel::MaybeCreate(
+    TabStripModel* tab_strip,
+    int context_index) {
+  auto model =
+      base::WrapUnique(new MoveToSpaceSubMenuModel(tab_strip, context_index));
+  return model->space_ids_.empty() ? nullptr : std::move(model);
+}
+
+MoveToSpaceSubMenuModel::MoveToSpaceSubMenuModel(TabStripModel* tab_strip,
+                                                 int context_index)
+    : ui::SimpleMenuModel(this),
+      tab_strip_(tab_strip),
+      context_index_(context_index) {
+  SpaceController* controller = GetController(tab_strip);
+  if (!controller || !tab_strip->ContainsIndex(context_index)) {
+    return;
+  }
+  const base::Uuid context_space =
+      controller->GetSpaceOfTab(tab_strip->GetTabAtIndex(context_index));
+  for (const Space& space : controller->registry()->spaces()) {
+    if (space.id == context_space) {
+      continue;
+    }
+    const int command_id = kMinCommandId + space_ids_.size();
+    space_ids_.push_back(space.id);
+    if (space.icon.empty()) {
+      AddItemWithIcon(
+          command_id, GetLabel(space),
+          ui::ImageModel::FromVectorIcon(
+              kCircleFilledIcon, GetTabGroupContextMenuColorId(space.color),
+              kSpaceIconSize));
+    } else {
+      AddItem(command_id, GetLabel(space));
+    }
+    SetMayHaveMnemonicsAt(GetItemCount() - 1, false);
+  }
+}
+
+MoveToSpaceSubMenuModel::~MoveToSpaceSubMenuModel() = default;
+
+void MoveToSpaceSubMenuModel::ExecuteCommand(int command_id, int event_flags) {
+  // The window may have changed while the menu was open.
+  SpaceController* controller = GetController(tab_strip_);
+  const size_t index = command_id - kMinCommandId;
+  if (!controller || command_id < kMinCommandId ||
+      index >= space_ids_.size()) {
+    return;
+  }
+  // Handles, since moving a tab can close none but reorders them all.
+  std::vector<tabs::TabHandle> handles;
+  for (tabs::TabInterface* tab :
+       GetTabsForMenuCommand(tab_strip_, context_index_)) {
+    handles.push_back(tab->GetHandle());
+  }
+  for (const tabs::TabHandle& handle : handles) {
+    tabs::TabInterface* tab = handle.Get();
+    if (tab && tab_strip_->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+      controller->MoveTabToSpace(tab, space_ids_[index]);
+    }
+  }
+}
+
+}  // namespace spaces
