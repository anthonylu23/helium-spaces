+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_MENU_MODEL_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_MENU_MODEL_H_
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/uuid.h"
+#include "ui/menus/simple_menu_model.h"
+
+class TabStripModel;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace spaces {
+
+// Spaces items of the tab context menu. Each does nothing, or returns
+// nullopt, in a window without spaces.
+
+// The tabs a tab menu command at `context_index` acts on: the selected tabs
+// if it is selected, otherwise only it, as in TabStripModel.
+std::vector<tabs::TabInterface*> GetTabsForMenuCommand(TabStripModel* tab_strip,
+                                                       int context_index);
+
+// The string of the Pin item for the tab at `context_index`, which pins if
+// `will_pin` and unpins otherwise, or nullopt to keep Chromium's
+// "Pin"/"Unpin". Unpinning favorites reads "Remove from Favorites" when the
+// item acts only on favorites.
+std::optional<int> GetPinMenuItemStringId(TabStripModel* tab_strip,
+                                          int context_index,
+                                          bool will_pin);
+
+// Whether the tab menu offers "Add to Favorites" next to Pin, which keeps a
+// tab in its space: for tabs that aren't favorites.
+bool ShouldShowAddToFavorites(TabStripModel* tab_strip, int context_index);
+
+// The "Move to space" submenu: the spaces other than the context tab's, in
+// switcher order. Moves the tabs the menu acts on, as SpaceController does.
+class MoveToSpaceSubMenuModel : public ui::SimpleMenuModel,
+                                public ui::SimpleMenuModel::Delegate {
+ public:
+  // Returns null in a window without spaces, or with no other space.
+  static std::unique_ptr<MoveToSpaceSubMenuModel> MaybeCreate(
+      TabStripModel* tab_strip,
+      int context_index);
+
+  MoveToSpaceSubMenuModel(const MoveToSpaceSubMenuModel&) = delete;
+  MoveToSpaceSubMenuModel& operator=(const MoveToSpaceSubMenuModel&) = delete;
+  ~MoveToSpaceSubMenuModel() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  MoveToSpaceSubMenuModel(TabStripModel* tab_strip, int context_index);
+
+  // Past the tab menu's own command ids, as Chromium's submenus are.
+  static constexpr int kMinCommandId = 2001;
+
+  const raw_ptr<TabStripModel> tab_strip_;
+  const int context_index_;
+  // The space of each item, by command id less kMinCommandId.
+  std::vector<base::Uuid> space_ids_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_MENU_MODEL_H_
